@inject IDialogService Dialog

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_etiqueta" Label="Nombre de la ronda" Variant="Variant.Outlined" Placeholder="Ej: Mañana, Tarde, Noche..." Autofocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm">Agregar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string _etiqueta = string.Empty;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(_etiqueta));
    private void Cancel()  => MudDialog.Cancel();
}
