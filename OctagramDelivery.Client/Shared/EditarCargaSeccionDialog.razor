@using OctagramDelivery.Application.DTOs
@using OctagramDelivery.Domain.Enums

<MudDialog>
    <TitleContent>
        <div style="display:flex;align-items:center;gap:10px;">
            <span class="material-symbols-rounded" style="color:var(--in);font-size:20px;">inventory_2</span>
            <div>
                <div style="font-size:15px;font-weight:700;">Editar carga</div>
                <div style="font-size:11px;color:var(--gray-muted);margin-top:1px;">@SeccionNombre · @RondaEtiqueta</div>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <p style="font-size:12px;color:var(--gray-muted);margin:0 0 14px;">
            Indica la cantidad cargada para esta sección en esta vuelta.
        </p>

        @foreach (var prod in Productos.OrderBy(p => p.Id))
        {
            var qty = _valores.TryGetValue(prod.Id, out var v) ? v : 0m;
            var esGramaje = prod.TipoMedida == TipoMedida.Gramaje;
            <div style="display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid var(--gray-line,#E5E7EB);">
                <span style="flex:1;font-size:13px;font-weight:500;color:var(--gray-dark);">@prod.Nombre</span>
                <MudNumericField T="decimal" Value="qty"
                                 ValueChanged="val => SetValor(prod.Id, val)"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="0" Format="@(esGramaje ? "0.###" : "0")"
                                 Style="width:96px;" />
                <span style="font-size:11px;color:var(--gray-muted);width:26px;text-align:left;">
                    @(esGramaje ? "kg" : "pzs")
                </span>
            </div>
        }

        @if (Productos.Count == 0)
        {
            <div class="empty-state" style="padding:16px 0;">
                <span class="material-symbols-rounded">inventory_2</span>
                <p>Esta sección no tiene productos configurados.</p>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Guardar">
            Guardar carga
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string SeccionNombre { get; set; } = "";
    [Parameter] public string RondaEtiqueta { get; set; } = "";
    /// <summary>productoId → cantidad actual para esta ronda</summary>
    [Parameter] public Dictionary<int, decimal> Stocks { get; set; } = new();
    [Parameter] public List<ProductDto> Productos { get; set; } = new();

    private Dictionary<int, decimal> _valores = new();

    protected override void OnInitialized()
    {
        _valores = new Dictionary<int, decimal>(Stocks);
    }

    private void SetValor(int prodId, decimal qty) => _valores[prodId] = qty;

    private void Guardar() => MudDialog.Close(DialogResult.Ok(_valores));
    private void Cancelar() => MudDialog.Cancel();
}
