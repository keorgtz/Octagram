@implements IDisposable
@inject NavigationManager Nav

@if (User.Rol != UserRole.Repartidor)
{
    @if (_moreOpen)
    {
        <div class="bottom-nav-more-backdrop" @onclick="CloseMore"></div>
        <div class="bottom-nav-more-menu">
            @foreach (var item in GetMoreItems())
            {
                <a href="@item.Href" class="bottom-nav-more-item" @onclick="CloseMore">
                    <span class="material-symbols-rounded">@item.Icon</span>
                    @item.Label
                </a>
            }
        </div>
    }

    <nav class="bottom-nav">
        @foreach (var item in GetMainItems())
        {
            var path = new Uri(Nav.Uri).AbsolutePath;
            var active = path.StartsWith(item.ActivePrefix, StringComparison.OrdinalIgnoreCase);
            <a href="@item.Href" class="bottom-nav-item @(active ? "bottom-nav-active" : "")"
               @onclick="CloseMore">
                <span class="material-symbols-rounded bottom-nav-icon">@item.Icon</span>
                <span class="bottom-nav-label">@item.Label</span>
            </a>
        }
        @if (GetMoreItems().Any())
        {
            var moreActive = IsMoreActive();
            <button class="bottom-nav-item bottom-nav-more-btn @(moreActive || _moreOpen ? "bottom-nav-active" : "")"
                    @onclick="ToggleMore">
                <span class="material-symbols-rounded bottom-nav-icon">@(_moreOpen ? "close" : "more_horiz")</span>
                <span class="bottom-nav-label">Más</span>
            </button>
        }
    </nav>
}

@code {
    [Parameter] public UserInfo User { get; set; } = null!;

    private bool _moreOpen;

    private record NavItem(string Href, string Icon, string Label, string ActivePrefix);

    protected override void OnInitialized()
        => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _moreOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void ToggleMore() => _moreOpen = !_moreOpen;
    private void CloseMore()  => _moreOpen = false;

    private bool IsMoreActive()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        return GetMoreItems().Any(item =>
            path.StartsWith(item.ActivePrefix, StringComparison.OrdinalIgnoreCase));
    }

    private int NegId => User.NegocioIds.FirstOrDefault();

    private IEnumerable<NavItem> GetMainItems() => User.Rol switch
    {
        UserRole.Admin => [
            new("/dashboard",           "dashboard",       "Inicio",   "/dashboard"),
            new("/gerente/jornadas",    "delivery_dining", "Jornadas", "/gerente/jornada"),
            new("/admin/negocios",      "store",           "Negocios", "/admin/negocios"),
        ],
        UserRole.Gerente => [
            new("/dashboard",           "dashboard",       "Inicio",    "/dashboard"),
            new("/gerente/jornadas",    "delivery_dining", "Jornadas",  "/gerente/jornada"),
            new("/catalogos/clientes",  "people",          "Clientes",  "/catalogos/clientes"),
            new("/historial",   "history",         "Historial", "/historial"),
        ],
        UserRole.Supervisor => BuildSupervisorMainItems(),
        _ => []
    };

    private IEnumerable<NavItem> GetMoreItems() => User.Rol switch
    {
        UserRole.Admin => [
            new("/admin/usuarios",      "manage_accounts", "Usuarios",  "/admin/usuarios"),
            new("/catalogos/clientes",  "people",          "Clientes",  "/catalogos/clientes"),
            new("/catalogos/grupos",    "folder_special",  "Grupos",    "/catalogos/grupos"),
            new("/catalogos/productos", "inventory_2",     "Productos", "/catalogos/productos"),
            new("/historial",     "history",         "Historial", "/historial"),
        ],
        UserRole.Gerente => [
            new("/catalogos/grupos",    "folder_special",  "Grupos",    "/catalogos/grupos"),
            new("/catalogos/productos", "inventory_2",     "Productos", "/catalogos/productos"),
        ],
        UserRole.Supervisor => BuildSupervisorMoreItems(),
        _ => []
    };

    // ── Supervisor: permisos granulares ──────────────────────────────

    private List<NavItem> BuildSupervisorMainItems()
    {
        var items = new List<NavItem>();
        if (User.TienePermiso(Permiso.VerDashboard, NegId))
            items.Add(new("/dashboard", "dashboard", "Inicio", "/dashboard"));
        if (User.TienePermiso(Permiso.VerHojaReparto, NegId))
            items.Add(new("/gerente/jornadas", "delivery_dining", "Jornadas", "/gerente/jornada"));
        if (User.TienePermiso(Permiso.GestionClientes, NegId))
            items.Add(new("/catalogos/clientes", "people", "Clientes", "/catalogos/clientes"));
        if (User.TienePermiso(Permiso.VerReportes, NegId))
            items.Add(new("/historial", "history", "Historial", "/historial"));
        return items;
    }

    private List<NavItem> BuildSupervisorMoreItems()
    {
        var items = new List<NavItem>();
        if (User.TienePermiso(Permiso.GestionProductos, NegId))
        {
            items.Add(new("/catalogos/grupos", "folder_special", "Grupos", "/catalogos/grupos"));
            items.Add(new("/catalogos/productos", "inventory_2", "Productos", "/catalogos/productos"));
        }
        return items;
    }
}