@inherits LayoutComponentBase
@inject AuthService AuthSvc
@inject NavigationManager Nav

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" />
<MudSnackbarProvider />

@if (_loading)
{
    <div style="display:flex;height:100vh;align-items:center;justify-content:center;background:var(--page-bg,#F2F3F7);">
        <div style="text-align:center;">
            <img src="favicon.png" style="width:48px;height:48px;border-radius:12px;" alt="Octagram" />
            <div style="font-size:13px;color:var(--gray-muted,#6B7280);margin-top:8px;">Cargando...</div>
        </div>
    </div>
}
else if (_user == null)
{
    <RedirectToLogin />
}
else if (_user.Rol == UserRole.Repartidor)
{
    <div class="rep-layout">
        <div class="rep-topbar">
            <div style="display:flex;align-items:center;gap:8px;">
                <img src="favicon.png" style="width:28px;height:28px;border-radius:6px;" alt="Octagram" />
                <span class="app-name">Octagram</span>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
                <span style="font-size:12px;color:var(--gray-muted);" class="hide-mobile">@_user.FullName</span>
                <NavLink href="/repartidor/historial" class="icon-btn" title="Historial">
                    <span class="material-symbols-rounded">history</span>
                </NavLink>
                <button class="icon-btn" @onclick="Logout" title="Cerrar sesión">
                    <span class="material-symbols-rounded">logout</span>
                </button>
            </div>
        </div>
        <div class="rep-content">@Body</div>
        <div class="status-bar">
            <span><span class="status-dot"></span>Conectado</span>
            <span>OctagramDelivery · @DateTime.Now.ToString("ddd d MMM", new System.Globalization.CultureInfo("es-MX"))</span>
        </div>
    </div>
}
else
{
    <div class="app-shell @(_sidebarOpen ? "" : "sidebar-collapsed")">

        <header class="titlebar">
            <button class="icon-btn" @onclick="ToggleSidebar" title="Menú">
                <span class="material-symbols-rounded">menu</span>
            </button>
            <div class="titlebar-brand">
                <img src="favicon.png" class="titlebar-brand-icon" alt="Octagram" />
                <span class="titlebar-brand-name">Octagram</span>
                <span class="titlebar-brand-sub">Delivery</span>
            </div>
            <div class="titlebar-spacer"></div>
            <div class="titlebar-user hide-mobile">
                <div class="user-avatar">@GetInitials(_user.FullName)</div>
                <span class="titlebar-username">@_user.FullName</span>
            </div>
            <button class="icon-btn" @onclick="Logout" title="Cerrar sesión">
                <span class="material-symbols-rounded">logout</span>
            </button>
        </header>

        <nav class="sidebar">
            <NavMenu UserRol="@_user.Rol" SidebarOpen="@_sidebarOpen" />
        </nav>

        <main class="main-content">@Body</main>

    </div>
}

@code {
    private UserInfo? _user;
    private bool _loading = true;
    private bool _sidebarOpen = true;

    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary             = "#1EB980",
            PrimaryContrastText = "#FFFFFF",
            Success             = "#10B981",
            Warning             = "#F59E0B",
            Error               = "#EF4444",
            Info                = "#6366F1",
            Background          = "#F2F3F7",
            Surface             = "#FFFFFF",
            DrawerBackground    = "#FFFFFF",
            TextPrimary         = "#1C1E26",
            TextSecondary       = "#6B7280",
            Divider             = "#E5E7EB",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Inter", "Segoe UI", "system-ui", "sans-serif"]
            }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        _user = await AuthSvc.GetCurrentUser();
        _loading = false;
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : name[0].ToString().ToUpper();
    }

    private async Task Logout()
    {
        await AuthSvc.Logout();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
