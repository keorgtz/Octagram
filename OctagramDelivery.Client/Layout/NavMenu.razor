@code {
    [Parameter] public UserRole UserRol { get; set; }
}

<MudNavMenu>
    @if (UserRol == UserRole.Admin)
    {
        <MudNavLink Href="/admin/dashboard" Icon="@Icons.Material.Rounded.Dashboard" Match="NavLinkMatch.All">Dashboard</MudNavLink>
        <MudNavLink Href="/admin/negocios" Icon="@Icons.Material.Rounded.Store">Negocios</MudNavLink>
        <MudNavLink Href="/admin/usuarios" Icon="@Icons.Material.Rounded.ManageAccounts">Usuarios</MudNavLink>
    }
    else if (UserRol == UserRole.Gerente)
    {
        <MudNavLink Href="/gerente/dashboard" Icon="@Icons.Material.Rounded.Dashboard" Match="NavLinkMatch.All">Dashboard</MudNavLink>
        <MudNavLink Href="/gerente/negocios" Icon="@Icons.Material.Rounded.Store">Mis Negocios</MudNavLink>
    }
    else if (UserRol == UserRole.Supervisor)
    {
        <MudNavLink Href="/supervisor/dashboard" Icon="@Icons.Material.Rounded.Dashboard" Match="NavLinkMatch.All">Dashboard</MudNavLink>
        <MudNavLink Href="/supervisor/clientes" Icon="@Icons.Material.Rounded.People">Clientes</MudNavLink>
        <MudNavLink Href="/supervisor/productos" Icon="@Icons.Material.Rounded.Inventory2">Productos</MudNavLink>
        <MudNavLink Href="/supervisor/repartidores" Icon="@Icons.Material.Rounded.DeliveryDining">Repartidores</MudNavLink>
    }
</MudNavMenu>
