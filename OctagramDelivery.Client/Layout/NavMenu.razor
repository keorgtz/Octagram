@inject NavigationManager Nav

<div class="nav-menu">

    @switch (User.Rol)
    {
        case UserRole.Admin:
            <div class="nav-section">
                <NavLink class="nav-item" href="/dashboard" Match="NavLinkMatch.All" ActiveClass="active">
                    <span class="material-symbols-rounded nav-item-icon">dashboard</span>
                    @if (SidebarOpen) { <span class="nav-item-label">Dashboard</span> }
                </NavLink>
            </div>

            <div class="nav-divider"></div>
            @if (SidebarOpen) { <div class="nav-category">Administración</div> }
            <div class="nav-section">
                <NavLink class="nav-item" href="/admin/negocios" Match="NavLinkMatch.Prefix" ActiveClass="active">
                    <span class="material-symbols-rounded nav-item-icon">store</span>
                    @if (SidebarOpen) { <span class="nav-item-label">Negocios</span> }
                </NavLink>
                <NavLink class="nav-item" href="/admin/usuarios" Match="NavLinkMatch.Prefix" ActiveClass="active">
                    <span class="material-symbols-rounded nav-item-icon">manage_accounts</span>
                    @if (SidebarOpen) { <span class="nav-item-label">Usuarios</span> }
                </NavLink>
            </div>

            <div class="nav-divider"></div>
            @if (SidebarOpen) { <div class="nav-category">Operaciones</div> }
            <div class="nav-section">
                <NavLink class="nav-item" href="/gerente/jornadas" Match="NavLinkMatch.Prefix" ActiveClass="active">
                    <span class="material-symbols-rounded nav-item-icon">delivery_dining</span>
                    @if (SidebarOpen) { <span class="nav-item-label">Jornada en Vivo</span> }
                </NavLink>
            </div>

            <div class="nav-divider"></div>
            @if (SidebarOpen) { <div class="nav-category">Catálogos</div> }
            <div class="nav-section">
                <NavLink class="nav-item" href="/catalogos/clientes" Match="NavLinkMatch.Prefix" ActiveClass="active">
                    <span class="material-symbols-rounded nav-item-icon">people</span>
                    @if (SidebarOpen) { <span class="nav-item-label">Clientes</span> }
                </NavLink>
                <NavLink class="nav-item" href="/catalogos/productos" Match="NavLinkMatch.Prefix" ActiveClass="active">
                    <span class="material-symbols-rounded nav-item-icon">inventory_2</span>
                    @if (SidebarOpen) { <span class="nav-item-label">Productos</span> }
                </NavLink>
                <NavLink class="nav-item" href="/catalogos/grupos" Match="NavLinkMatch.Prefix" ActiveClass="active">
                    <span class="material-symbols-rounded nav-item-icon">folder_special</span>
                    @if (SidebarOpen) { <span class="nav-item-label">Grupos</span> }
                </NavLink>
            </div>

            <div class="nav-divider"></div>
            @if (SidebarOpen) { <div class="nav-category">Reportes</div> }
            <div class="nav-section">
                <NavLink class="nav-item" href="/historial" Match="NavLinkMatch.Prefix" ActiveClass="active">
                    <span class="material-symbols-rounded nav-item-icon">history</span>
                    @if (SidebarOpen) { <span class="nav-item-label">Historial</span> }
                </NavLink>
            </div>
            break;

        case UserRole.Gerente:
            <div class="nav-section">
                <NavLink class="nav-item" href="/dashboard" Match="NavLinkMatch.All" ActiveClass="active">
                    <span class="material-symbols-rounded nav-item-icon">dashboard</span>
                    @if (SidebarOpen) { <span class="nav-item-label">Dashboard</span> }
                </NavLink>
                <NavLink class="nav-item" href="/gerente/jornadas" Match="NavLinkMatch.Prefix" ActiveClass="active">
                    <span class="material-symbols-rounded nav-item-icon">delivery_dining</span>
                    @if (SidebarOpen) { <span class="nav-item-label">Jornada en Vivo</span> }
                </NavLink>
            </div>

            <div class="nav-divider"></div>
            @if (SidebarOpen) { <div class="nav-category">Catálogos</div> }
            <div class="nav-section">
                <NavLink class="nav-item" href="/catalogos/clientes" Match="NavLinkMatch.Prefix" ActiveClass="active">
                    <span class="material-symbols-rounded nav-item-icon">people</span>
                    @if (SidebarOpen) { <span class="nav-item-label">Clientes</span> }
                </NavLink>
                <NavLink class="nav-item" href="/catalogos/productos" Match="NavLinkMatch.Prefix" ActiveClass="active">
                    <span class="material-symbols-rounded nav-item-icon">inventory_2</span>
                    @if (SidebarOpen) { <span class="nav-item-label">Productos</span> }
                </NavLink>
                <NavLink class="nav-item" href="/catalogos/grupos" Match="NavLinkMatch.Prefix" ActiveClass="active">
                    <span class="material-symbols-rounded nav-item-icon">folder_special</span>
                    @if (SidebarOpen) { <span class="nav-item-label">Grupos</span> }
                </NavLink>
            </div>

            <div class="nav-divider"></div>
            @if (SidebarOpen) { <div class="nav-category">Reportes</div> }
            <div class="nav-section">
                <NavLink class="nav-item" href="/historial" Match="NavLinkMatch.Prefix" ActiveClass="active">
                    <span class="material-symbols-rounded nav-item-icon">history</span>
                    @if (SidebarOpen) { <span class="nav-item-label">Historial</span> }
                </NavLink>
            </div>
            break;

        case UserRole.Supervisor:
            @if (User.TienePermiso(Permiso.VerDashboard, NegId))
            {
                <div class="nav-section">
                    <NavLink class="nav-item" href="/dashboard" Match="NavLinkMatch.All" ActiveClass="active">
                        <span class="material-symbols-rounded nav-item-icon">dashboard</span>
                        @if (SidebarOpen) { <span class="nav-item-label">Dashboard</span> }
                    </NavLink>
                </div>
                <div class="nav-divider"></div>
            }
            @if (User.TienePermiso(Permiso.VerHojaReparto, NegId))
            {
                <div class="nav-section">
                    <NavLink class="nav-item" href="/gerente/jornadas" Match="NavLinkMatch.Prefix" ActiveClass="active">
                        <span class="material-symbols-rounded nav-item-icon">delivery_dining</span>
                        @if (SidebarOpen) { <span class="nav-item-label">Jornada en Vivo</span> }
                    </NavLink>
                </div>
                <div class="nav-divider"></div>
            }

            @if (User.TienePermiso(Permiso.GestionClientes, NegId) || User.TienePermiso(Permiso.GestionProductos, NegId) || User.TienePermiso(Permiso.GestionGrupos, NegId))
            {
                @if (SidebarOpen) { <div class="nav-category">Catálogos</div> }
                <div class="nav-section">
                    @if (User.TienePermiso(Permiso.GestionClientes, NegId))
                    {
                        <NavLink class="nav-item" href="/catalogos/clientes" Match="NavLinkMatch.Prefix" ActiveClass="active">
                            <span class="material-symbols-rounded nav-item-icon">people</span>
                            @if (SidebarOpen) { <span class="nav-item-label">Clientes</span> }
                        </NavLink>
                    }
                    @if (User.TienePermiso(Permiso.GestionProductos, NegId))
                    {
                        <NavLink class="nav-item" href="/catalogos/productos" Match="NavLinkMatch.Prefix" ActiveClass="active">
                            <span class="material-symbols-rounded nav-item-icon">inventory_2</span>
                            @if (SidebarOpen) { <span class="nav-item-label">Productos</span> }
                        </NavLink>
                    }
                    @if (User.TienePermiso(Permiso.GestionGrupos, NegId))
                    {
                        <NavLink class="nav-item" href="/catalogos/grupos" Match="NavLinkMatch.Prefix" ActiveClass="active">
                            <span class="material-symbols-rounded nav-item-icon">folder_special</span>
                            @if (SidebarOpen) { <span class="nav-item-label">Grupos</span> }
                        </NavLink>
                    }
                </div>
                <div class="nav-divider"></div>
            }

            @if (User.TienePermiso(Permiso.VerReportes, NegId))
            {
                @if (SidebarOpen) { <div class="nav-category">Reportes</div> }
                <div class="nav-section">
                    <NavLink class="nav-item" href="/historial" Match="NavLinkMatch.Prefix" ActiveClass="active">
                        <span class="material-symbols-rounded nav-item-icon">history</span>
                        @if (SidebarOpen) { <span class="nav-item-label">Historial</span> }
                    </NavLink>
                </div>
            }
            break;
    }

</div>

@code {
    [Parameter] public UserInfo User { get; set; } = null!;
    [Parameter] public bool SidebarOpen { get; set; } = true;

    private int NegId => User?.NegocioIds.FirstOrDefault() ?? 0;
}