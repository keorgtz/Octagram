@page "/"
@inject AuthService AuthSvc
@inject NavigationManager Nav

@code {
    protected override async Task OnInitializedAsync()
    {
        var user = await AuthSvc.GetCurrentUser();
        if (user == null) { Nav.NavigateTo("/login"); return; }

        Nav.NavigateTo(user.Rol switch
        {
            UserRole.Admin      => "/dashboard",
            UserRole.Gerente    => "/dashboard",
            UserRole.Supervisor => "/dashboard",
            _                   => "/repartidor/jornada"
        }, replace: true);
    }
}
