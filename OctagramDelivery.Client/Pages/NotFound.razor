@page "/not-found"
@layout MainLayout

<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:64px 16px;text-align:center;">
    <div style="font-size:72px;font-weight:800;color:var(--in);line-height:1;">404</div>
    <div style="font-size:20px;font-weight:600;color:var(--gray-dark);margin:8px 0 4px;">Página no encontrada</div>
    <div style="font-size:14px;color:var(--gray-muted);margin-bottom:24px;">El recurso que buscas no existe o fue movido.</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">Ir al inicio</MudButton>
</div>
