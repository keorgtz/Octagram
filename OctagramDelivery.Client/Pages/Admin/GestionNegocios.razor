@page "/admin/negocios"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inject ApiService Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>Negocios · OctagramDelivery</PageTitle>

<div class="page-content">

    <div class="page-header">
        <div>
            <h1 class="h-page-title">Negocios</h1>
            <p class="page-subtitle">Gestión de tenants y negocios registrados</p>
        </div>
        <div class="page-header-actions">
            <MudButton StartIcon="@Icons.Material.Rounded.Add"
                       Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="AbrirCrear">
                Nuevo Negocio
            </MudButton>
        </div>
    </div>

    @if (_cargando)
    {
        <div class="loading-state"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
    }
    else
    {
        <div class="data-card">
            <MudTable Items="_negocios" Hover="true" Dense="true" Striped="false">
                <HeaderContent>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Dirección</MudTh>
                    <MudTh Style="text-align:center;">Repartidores</MudTh>
                    <MudTh Style="text-align:center;">Estado</MudTh>
                    <MudTh Style="width:108px;text-align:center;">Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><span class="fw-600">@context.Nombre</span></MudTd>
                    <MudTd><span class="text-muted">@(context.Direccion ?? "—")</span></MudTd>
                    <MudTd Style="text-align:center;">
                        <span class="fw-600 text-primary">@context.TotalRepartidores</span>
                    </MudTd>
                    <MudTd Style="text-align:center;">
                        <MudChip T="string"
                                 Color="@(context.IsActive ? Color.Success : Color.Default)"
                                 Size="Size.Small" Variant="Variant.Filled">
                            @(context.IsActive ? "Activo" : "Inactivo")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align:center;">
                        <div style="display:inline-flex;gap:2px;align-items:center;">
                            <MudIconButton Icon="@Icons.Material.Rounded.ManageAccounts"
                                           Size="Size.Small" Color="Color.Primary"
                                           title="Gestionar negocio"
                                           OnClick="@(() => AbrirGestionar(context))" />
                            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                           Size="Size.Small" Color="Color.Default"
                                           title="Editar"
                                           OnClick="@(() => AbrirEditar(context))" />
                            <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                           Size="Size.Small" Color="Color.Default"
                                           title="Desactivar"
                                           OnClick="@(() => Eliminar(context))" />
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="empty-state">
                        <span class="material-symbols-rounded">storefront</span>
                        <p>No hay negocios registrados aún.</p>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </div>
    }

</div>

<MudDialog @bind-Visible="_dialogOpen">
    <TitleContent>
        <div style="display:flex;align-items:center;gap:10px;">
            <span class="material-symbols-rounded" style="color:var(--primary);font-size:20px;">store</span>
            <span>@(_editando?.Id > 0 ? "Editar Negocio" : "Nuevo Negocio")</span>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_editando != null)
        {
            <MudTextField @bind-Value="_editando.Nombre" Label="Nombre del negocio"
                          Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Store" />
            <MudTextField @bind-Value="_editando.Direccion" Label="Dirección"
                          Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.LocationOn" />
            <MudTextField @bind-Value="_editando.LogoUrl" Label="URL del Logo (opcional)"
                          Variant="Variant.Outlined" FullWidth="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Image" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CerrarDialog">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Guardar">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<TenantDto> _negocios = new();
    private bool _cargando = true;
    private bool _dialogOpen;
    private TenantDto? _editando;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        _cargando = true;
        _negocios = await Api.GetNegociosAsync() ?? new();
        _cargando = false;
    }

    private async Task AbrirGestionar(TenantDto t)
    {
        var parameters = new DialogParameters
        {
            ["TenantId"]      = t.Id,
            ["NombreNegocio"] = t.Nombre
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true
        };
        await Dialog.ShowAsync<NegocioDetailDialog>("", parameters, options);
        await Cargar();
    }

    private void AbrirCrear() { _editando = new TenantDto(); _dialogOpen = true; }

    private void AbrirEditar(TenantDto t)
    {
        _editando = new TenantDto { Id = t.Id, Nombre = t.Nombre, Direccion = t.Direccion, LogoUrl = t.LogoUrl };
        _dialogOpen = true;
    }

    private void CerrarDialog() { _dialogOpen = false; _editando = null; }

    private async Task Guardar()
    {
        if (_editando == null) return;
        var req = new CreateTenantRequest { Nombre = _editando.Nombre, Direccion = _editando.Direccion, LogoUrl = _editando.LogoUrl };
        var resp = _editando.Id > 0
            ? await Api.UpdateNegocioAsync(_editando.Id, req)
            : await Api.CreateNegocioAsync(req);

        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Negocio guardado.", Severity.Success);
            CerrarDialog();
            await Cargar();
        }
        else Snackbar.Add("Error al guardar el negocio.", Severity.Error);
    }

    private async Task Eliminar(TenantDto t)
    {
        var ok = await Dialog.ShowMessageBox("Desactivar negocio",
            $"¿Desactivar el negocio \"{t.Nombre}\"? Los datos se conservarán.",
            yesText: "Desactivar", cancelText: "Cancelar");
        if (ok == true)
        {
            await Api.DeleteNegocioAsync(t.Id);
            Snackbar.Add("Negocio desactivado.", Severity.Warning);
            await Cargar();
        }
    }
}
