@page "/admin/usuarios"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inject ApiService Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>Usuarios · OctagramDelivery</PageTitle>

<div class="page-content">

    <div class="page-header">
        <div>
            <h1 class="h-page-title">Usuarios</h1>
            <p class="page-subtitle">Gestión de accesos y roles del sistema</p>
        </div>
        <div class="page-header-actions">
            <MudButton StartIcon="@Icons.Material.Rounded.PersonAdd"
                       Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="AbrirCrear">
                Nuevo Usuario
            </MudButton>
        </div>
    </div>

    @if (_cargando)
    {
        <div class="loading-state"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
    }
    else
    {
        <div class="data-card">
            <MudTable Items="_usuarios" Hover="true" Dense="true" Striped="false" Filter="FilterFunc">
                <ToolBarContent>
                    <MudTextField @bind-Value="_busqueda"
                                  Placeholder="Buscar por usuario o nombre..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Rounded.Search"
                                  FullWidth="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Usuario</MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh Style="text-align:center;">Rol</MudTh>
                    <MudTh>Negocios</MudTh>
                    <MudTh Style="text-align:center;">Estado</MudTh>
                    <MudTh Style="width:72px;text-align:center;">Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <span style="font-family:monospace;font-size:13px;font-weight:600;color:var(--primary);">@context.Username</span>
                    </MudTd>
                    <MudTd><span class="fw-500">@context.FullName</span></MudTd>
                    <MudTd Style="text-align:center;">
                        <MudChip T="string" Color="@GetRolColor(context.Rol)"
                                 Size="Size.Small" Variant="Variant.Filled">
                            @context.Rol
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <span class="text-muted" style="font-size:12px;">
                            @(context.NegocioNombres.Any() ? string.Join(", ", context.NegocioNombres.Take(2)) : "—")
                        </span>
                    </MudTd>
                    <MudTd Style="text-align:center;">
                        <MudChip T="string"
                                 Color="@(context.IsActive ? Color.Success : Color.Default)"
                                 Size="Size.Small" Variant="Variant.Filled">
                            @(context.IsActive ? "Activo" : "Inactivo")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align:center;">
                        <div style="display:inline-flex;gap:2px;align-items:center;">
                            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                           Size="Size.Small" Color="Color.Default"
                                           title="Editar"
                                           OnClick="@(() => AbrirEditar(context))" />
                            <MudIconButton Icon="@Icons.Material.Rounded.PersonOff"
                                           Size="Size.Small" Color="Color.Default"
                                           title="Desactivar"
                                           OnClick="@(() => Desactivar(context))" />
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="empty-state">
                        <span class="material-symbols-rounded">person_off</span>
                        <p>No se encontraron usuarios.</p>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </div>
    }

</div>

<MudDialog @bind-Visible="_dialogOpen">
    <TitleContent>
        <div style="display:flex;align-items:center;gap:10px;">
            <span class="material-symbols-rounded" style="color:var(--primary);font-size:20px;">
                @(_esCrear ? "person_add" : "manage_accounts")
            </span>
            <span>@(_esCrear ? "Nuevo Usuario" : "Editar Usuario")</span>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_esCrear)
        {
            <MudTextField @bind-Value="_username" Label="Username"
                          Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.AlternateEmail" />
            <MudTextField @bind-Value="_password" Label="Contraseña"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Lock" />
        }
        <MudTextField @bind-Value="_fullName" Label="Nombre Completo"
                      Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Person" />
        <MudSelect T="UserRole" @bind-Value="_rol" Label="Rol"
                   Variant="Variant.Outlined" FullWidth="true" Class="mb-3">
            @foreach (UserRole r in Enum.GetValues<UserRole>())
            {
                <MudSelectItem T="UserRole" Value="r">@r</MudSelectItem>
            }
        </MudSelect>
        @if (!_esCrear)
        {
            <MudTextField @bind-Value="_newPassword"
                          Label="Nueva contraseña (dejar vacío para no cambiar)"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.LockReset" />
        }
        <MudSelect T="int" @bind-SelectedValues="_selectedNegocios"
                   Label="Negocios asignados" MultiSelection="true"
                   Variant="Variant.Outlined" FullWidth="true">
            @foreach (var n in _negociosList)
            {
                <MudSelectItem T="int" Value="n.Id">@n.Nombre</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CerrarDialog">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Guardar">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<UserDto>   _usuarios    = new();
    private List<TenantDto> _negociosList = new();
    private bool   _cargando = true;
    private string _busqueda = string.Empty;

    private bool   _dialogOpen;
    private bool   _esCrear;
    private int    _editId;
    private string _username = "", _password = "", _fullName = "", _newPassword = "";
    private UserRole _rol = UserRole.Repartidor;
    private IEnumerable<int> _selectedNegocios = new List<int>();

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        (_usuarios, _negociosList) = (await Api.GetUsuariosAsync() ?? new(), await Api.GetNegociosAsync() ?? new());
        _cargando = false;
    }

    private bool FilterFunc(UserDto u) =>
        string.IsNullOrEmpty(_busqueda) ||
        u.Username.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
        u.FullName.Contains(_busqueda,  StringComparison.OrdinalIgnoreCase);

    private void AbrirCrear()
    {
        _esCrear = true; _editId = 0;
        _username = _password = _fullName = _newPassword = "";
        _rol = UserRole.Repartidor;
        _selectedNegocios = new List<int>();
        _dialogOpen = true;
    }

    private void AbrirEditar(UserDto u)
    {
        _esCrear = false; _editId = u.Id;
        _username = u.Username; _fullName = u.FullName; _newPassword = "";
        _rol = u.Rol; _selectedNegocios = u.NegocioIds;
        _dialogOpen = true;
    }

    private void CerrarDialog() => _dialogOpen = false;

    private async Task Guardar()
    {
        HttpResponseMessage resp;
        if (_esCrear)
            resp = await Api.CreateUsuarioAsync(new CreateUserRequest
            {
                Username = _username, Password = _password,
                FullName = _fullName, Rol = _rol,
                NegocioIds = _selectedNegocios.ToList()
            });
        else
            resp = await Api.UpdateUsuarioAsync(_editId, new UpdateUserRequest
            {
                FullName = _fullName, Rol = _rol, IsActive = true,
                NegocioIds = _selectedNegocios.ToList(),
                NewPassword = string.IsNullOrEmpty(_newPassword) ? null : _newPassword
            });

        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Usuario guardado.", Severity.Success);
            CerrarDialog();
            _usuarios = await Api.GetUsuariosAsync() ?? new();
        }
        else Snackbar.Add("Error al guardar el usuario.", Severity.Error);
    }

    private async Task Desactivar(UserDto u)
    {
        var ok = await Dialog.ShowMessageBox("Desactivar usuario",
            $"¿Desactivar a {u.FullName}? Podrá reactivarlo después.",
            yesText: "Desactivar", cancelText: "Cancelar");
        if (ok == true)
        {
            await Api.DeleteUsuarioAsync(u.Id);
            Snackbar.Add("Usuario desactivado.", Severity.Warning);
            _usuarios = await Api.GetUsuariosAsync() ?? new();
        }
    }

    private static Color GetRolColor(UserRole r) => r switch
    {
        UserRole.Admin      => Color.Error,
        UserRole.Gerente    => Color.Warning,
        UserRole.Supervisor => Color.Info,
        _                   => Color.Success
    };
}
