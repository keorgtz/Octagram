@page "/admin/dashboard"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Dashboard Admin · OctagramDelivery</PageTitle>

<div class="page-content">

    <div class="page-header">
        <div>
            <h1 class="h-page-title">Administración Global</h1>
            <p class="page-subtitle">Vista general de todos los negocios y repartidores</p>
        </div>
        <div class="page-header-actions">
            <MudButton StartIcon="@Icons.Material.Rounded.Store"
                       Variant="Variant.Outlined" Color="Color.Primary"
                       Href="/admin/negocios">Negocios</MudButton>
            <MudButton StartIcon="@Icons.Material.Rounded.ManageAccounts"
                       Variant="Variant.Outlined" Color="Color.Primary"
                       Href="/admin/usuarios">Usuarios</MudButton>
            <MudIconButton Icon="@Icons.Material.Rounded.Refresh"
                           Color="Color.Primary" title="Actualizar"
                           OnClick="Cargar" />
        </div>
    </div>

    @if (_cargando)
    {
        <div class="loading-state">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (_data == null)
    {
        <div class="empty-state">
            <span class="material-symbols-rounded">error_outline</span>
            <p>No se pudieron cargar los datos.</p>
        </div>
    }
    else
    {
        <div class="kpi-grid">
            <div class="kpi-card" style="--accent-color:var(--primary);">
                <div class="kpi-label">Negocios</div>
                <div class="kpi-value">@_data.TotalNegocios</div>
            </div>
            <div class="kpi-card" style="--accent-color:var(--em);">
                <div class="kpi-label">Repartidores Activos</div>
                <div class="kpi-value">@_data.TotalRepartidoresActivos</div>
            </div>
            <div class="kpi-card" style="--accent-color:var(--primary);">
                <div class="kpi-label">Efectivo Global Hoy</div>
                <div class="kpi-value" style="font-size:22px;">@_data.TotalEfectivoGlobal.ToString("C0", _mx)</div>
            </div>
        </div>

        @foreach (var neg in _data.Negocios)
        {
            <MudCard Class="mb-3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
                            <span style="font-size:15px;font-weight:700;color:var(--gray-dark);">@neg.TenantNombre</span>
                            <div class="neg-stats">
                                <span class="neg-stat">
                                    <span class="material-symbols-rounded" style="font-size:16px;color:var(--em);">circle</span>
                                    <strong>@neg.RepartidoresActivos</strong> activos
                                </span>
                                <span class="neg-stat">
                                    <span class="material-symbols-rounded" style="font-size:16px;color:var(--gray-muted);">circle</span>
                                    <strong>@neg.RepartidoresCerrados</strong> cerrados
                                </span>
                                <span class="tabnum fw-700 text-in" style="font-size:15px;">
                                    @neg.TotalEfectivoEnCalle.ToString("C0", _mx)
                                </span>
                            </div>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="padding:0;">
                    <MudTable Items="neg.Repartidores" Hover="true" Dense="true" Striped="false">
                        <HeaderContent>
                            <MudTh>Repartidor</MudTh>
                            <MudTh Style="text-align:center;">Clientes</MudTh>
                            <MudTh Style="text-align:right;">Entregado</MudTh>
                            <MudTh Style="text-align:right;">Neto</MudTh>
                            <MudTh Style="text-align:right;">Efectivo</MudTh>
                            <MudTh Style="text-align:center;">Estado</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><span class="fw-500">@context.FullName</span></MudTd>
                            <MudTd Style="text-align:center;color:var(--gray-muted);">
                                @context.ClientesAtendidos<span style="opacity:.5;">/</span>@context.TotalClientes
                            </MudTd>
                            <MudTd Style="text-align:right;" Class="tabnum text-em">@context.TotalEntregado.ToString("C0", _mx)</MudTd>
                            <MudTd Style="text-align:right;" Class="tabnum text-vi fw-600">@context.TotalNeto.ToString("C0", _mx)</MudTd>
                            <MudTd Style="text-align:right;" Class="tabnum text-in fw-700">@context.TotalEfectivo.ToString("C0", _mx)</MudTd>
                            <MudTd Style="text-align:center;">
                                <MudChip T="string"
                                         Color="@(context.Estado == JornadaEstado.Abierta ? Color.Success : Color.Default)"
                                         Size="Size.Small" Variant="Variant.Filled">
                                    @(context.Estado == JornadaEstado.Abierta ? "Activo" : "Cerrado")
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        }
    }

</div>

@code {
    private static readonly System.Globalization.CultureInfo _mx = new("es-MX");

    private DashboardAdminDto? _data;
    private bool _cargando = true;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        _cargando = true;
        _data = await Api.GetDashboardAdminAsync();
        _cargando = false;
    }
}
