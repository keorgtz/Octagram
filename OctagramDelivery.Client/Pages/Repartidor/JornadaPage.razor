@page "/repartidor/jornada"
@page "/gerente/jornada/{JornadaId:int}"
@attribute [Authorize(Roles = $"{nameof(UserRole.Repartidor)},{nameof(UserRole.Gerente)},{nameof(UserRole.Supervisor)},{nameof(UserRole.Admin)}")]
@implements IDisposable
@inject ApiService Api
@inject AuthService AuthSvc
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Nav
@inject JornadaStateService Estado
@inject LocalDataService LocalData
@inject OfflineSyncService OfflineSync

<PageTitle>Jornada · TortiCloud</PageTitle>

@if (_loadedFromCache && !OfflineSync.IsOnline)
{
    <div style="background:#FEF3C7;border-bottom:1px solid #FDE68A;padding:8px 16px;display:flex;align-items:center;gap:8px;font-size:12px;color:#92400E;">
        <span class="material-symbols-rounded" style="font-size:16px;">wifi_off</span>
        Sin conexión — mostrando datos guardados localmente.
    </div>
}

@if (_cargando)
{
    <div style="display:flex;height:60vh;align-items:center;justify-content:center;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (_mostrarPickerJornadas && _misJornadasHoy != null)
{
    <!-- Selector de jornadas: hay más de una jornada hoy -->
    <div class="jorpicker-container">
        <div class="jorpicker-header">
            <span class="material-symbols-rounded" style="font-size:32px;color:var(--in,#6366F1);">delivery_dining</span>
            <div>
                <div class="jorpicker-titulo">Mis jornadas de hoy</div>
                <div class="jorpicker-sub">Selecciona una para continuar</div>
            </div>
        </div>

        @{ var idx = 0; }
        @foreach (var j in _misJornadasHoy.OrderBy(x => x.FechaApertura))
        {
            idx++;
            var jLocal  = j;
            var isAbierta = j.Estado == JornadaEstado.Abierta;
            <button class="jorpicker-card" @onclick="() => SeleccionarJornada(jLocal)">
                <div class="jorpicker-card-left">
                    <span class="jorpicker-dot @(isAbierta ? "abierta" : "cerrada")"></span>
                    <div>
                        <div class="jorpicker-card-titulo">Jornada @idx</div>
                        <div class="jorpicker-card-hora">
                            Abierta @j.FechaApertura.ToLocalTime().ToString("hh:mm tt")
                            @if (!isAbierta && j.FechaCierre.HasValue)
                            {
                                <span> · Cerrada @j.FechaCierre.Value.ToLocalTime().ToString("hh:mm tt")</span>
                            }
                        </div>
                    </div>
                </div>
                <span class="jorpicker-estado @(isAbierta ? "abierta" : "cerrada")">
                    @(isAbierta ? "Activa" : "Cerrada")
                </span>
                <span class="material-symbols-rounded" style="color:var(--gray-muted);font-size:20px;flex-shrink:0;">chevron_right</span>
            </button>
        }

        @if (_puedeAbrir && !_soloLectura)
        {
            <button class="jorpicker-nueva-btn" @onclick="AbrirJornada">
                <span class="material-symbols-rounded">add_circle</span>
                Abrir nueva jornada
            </button>
        }
    </div>
}
else if (Estado.Jornada == null)
{
    @if (_sinDatosLocales)
    {
        <!-- Sin datos locales: offline sin caché -->
        <div style="padding:32px 24px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px;">
            <span class="material-symbols-rounded" style="font-size:64px;color:var(--gray-muted);">cloud_off</span>
            <h2 style="color:var(--gray-dark);margin:0;">Sin datos locales</h2>
            <p style="color:var(--gray-muted);margin:0;max-width:280px;">
                No hay datos guardados en este dispositivo. Conéctate a internet y sincroniza.
            </p>
            @if (OfflineSync.IsOnline)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Rounded.CloudSync"
                           Disabled="_sincronizando"
                           OnClick="SincronizarDatosAsync"
                           Style="margin-top:4px;">
                    @(_sincronizando ? "Sincronizando…" : "Bajar datos de la nube")
                </MudButton>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Dense="true">Sin conexión a internet</MudAlert>
            }
        </div>
    }
    else
    {
        <!-- Sin jornada activa (confirmado por la API) -->
        <div style="padding:32px 24px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:12px;">
            <span class="material-symbols-rounded" style="font-size:64px;color:var(--gray-muted);">delivery_dining</span>
            <h2 style="color:var(--gray-dark);margin:0;">Sin jornada activa</h2>
            <p style="color:var(--gray-muted);margin:0;">No hay una jornada abierta para hoy.</p>
            @if (_negocioId > 0 && !_soloLectura && _puedeAbrir)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AbrirJornada"
                           StartIcon="@Icons.Material.Rounded.PlayCircle" Style="margin-top:4px;">
                    Abrir Jornada de Hoy
                </MudButton>
            }
            else if (!_puedeAbrir)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Rounded.ArrowBack"
                           OnClick='() => Nav.NavigateTo("/gerente/jornadas")'>
                    Ver jornadas activas
                </MudButton>
            }
            else if (_negocioId == 0)
            {
                <MudAlert Severity="Severity.Warning">No tienes un negocio asignado.</MudAlert>
            }
        </div>
    }
}
else
{
    <div class="jornada-mobile-header">
        <div class="jornada-mobile-meta">
            @if (JornadaId.HasValue)
            {
                <button class="icon-btn" @onclick='() => Nav.NavigateTo("/gerente/jornadas")'>
                    <span class="material-symbols-rounded">arrow_back</span>
                </button>
            }
            else if (_vista != Vista.Home)
            {
                <button class="icon-btn" @onclick="() => _vista = Vista.Home">
                    <span class="material-symbols-rounded">arrow_back</span>
                </button>
            }
            <div style="min-width:0;flex:1;">
                <div class="fw-700" style="font-size:15px;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                    @(JornadaId.HasValue ? Estado.Jornada.DriverNombre : Estado.Jornada.TenantNombre)
                </div>
                <div class="text-muted" style="font-size:12px;margin-top:2px;">
                    @if (JornadaId.HasValue)
                    {
                        <span>@Estado.Jornada.TenantNombre · @Estado.Jornada.Fecha.ToString("d 'de' MMMM", _mx)</span>
                    }
                    else
                    {
                        @Estado.Jornada.Fecha.ToString("dddd d 'de' MMMM", _mx)
                    }
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
                @if (_soloLectura)
                {
                    <span class="badge-solo-lectura">
                        <span class="material-symbols-rounded" style="font-size:13px;">visibility</span>
                        Solo lectura
                    </span>
                }
                else if (Estado.Jornada.Estado == JornadaEstado.Abierta)
                {
                    <MudButton StartIcon="@Icons.Material.Rounded.CheckCircleOutline"
                               Variant="Variant.Filled" Color="Color.Success"
                               Size="Size.Small" OnClick="CerrarJornada">
                        Cerrar
                    </MudButton>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">Cerrada</MudChip>
                }
            </div>
        </div>

        @{
            var clientesGrupoIds = _grupoFiltro == null
                ? Estado.Clientes.Select(c => c.Id)
                : Estado.Clientes.Where(c => c.Grupo == _grupoFiltro).Select(c => c.Id);
            var (bruto, neto, efect, _, _) = Estado.TotalesFiltrados(clientesGrupoIds);
        }
        <div class="jornada-mobile-totales">
            @if (_mostrarDinero)
            {
                <div class="jornada-mini-total">
                    <span class="jornada-mini-label">Bruto</span>
                    <span class="jornada-mini-value text-em">@bruto.ToString("C", _mx)</span>
                </div>
                <div class="jornada-mini-total">
                    <span class="jornada-mini-label">Neto</span>
                    <span class="jornada-mini-value text-vi">@neto.ToString("C", _mx)</span>
                </div>
                <div class="jornada-mini-total">
                    <span class="jornada-mini-label">Efectivo</span>
                    <span class="jornada-mini-value text-in">@efect.ToString("C", _mx)</span>
                </div>
            }
            else
            {
                var totalesProd = GetTotalesProductos();
                if (totalesProd.Count == 0)
                {
                    <div class="jornada-mini-total">
                        <span class="jornada-mini-label">Sin entregas</span>
                        <span class="jornada-mini-value" style="color:var(--gray-muted);">—</span>
                    </div>
                }
                else
                {
                    foreach (var pt in totalesProd)
                    {
                        <div class="jornada-mini-total @(pt.EsGrupo ? "es-grupo" : "")">
                            <span class="jornada-mini-label">@pt.Nombre</span>
                            <span class="jornada-mini-value" style="color:@(pt.EsGrupo ? "var(--vi)" : "var(--gray-dark)");">
                                @(pt.EsGramaje ? $"{pt.Total:0.##} kg" : $"{pt.Total:0.##} pzs")
                            </span>
                        </div>
                    }
                }
            }
            <button class="jornada-totales-toggle"
                    @onclick="() => _mostrarDinero = !_mostrarDinero"
                    title="@(_mostrarDinero ? "Ver cantidades" : "Ver dinero")">
                <span class="material-symbols-rounded">
                    @(_mostrarDinero ? "straighten" : "attach_money")
                </span>
            </button>
        </div>

        <div style="display:flex;align-items:center;gap:8px;">
            @if (!_soloLectura)
            {
                <span class="save-indicator @_saveClass" style="flex:1;font-size:11px;">@_saveText</span>
                @if (Estado.Jornada.Estado == JornadaEstado.Abierta)
                {
                    <button class="icon-btn" title="Agregar vuelta" @onclick="AgregarRonda">
                        <span class="material-symbols-rounded">add_circle</span>
                    </button>
                }
                @if (_puedeAbrir)
                {
                    <button class="icon-btn" title="Abrir nueva jornada" @onclick="AbrirJornada">
                        <span class="material-symbols-rounded">add_task</span>
                    </button>
                }
            }
            else
            {
                <span style="flex:1;"></span>
            }
            @if ((_misJornadasHoy?.Count ?? 0) > 1)
            {
                <button class="icon-btn" title="Mis jornadas de hoy" @onclick="() => _mostrarPickerJornadas = true">
                    <span class="material-symbols-rounded">swap_horiz</span>
                </button>
            }
            @if (!JornadaId.HasValue)
            {
                @if (OfflineSync.IsOnline)
                {
                    <button class="icon-btn @(_sincronizando ? "syncing" : "")"
                            title="@(_sincronizando ? "Sincronizando…" : "Sincronizar datos desde la nube")"
                            @onclick="SincronizarDatosAsync" disabled="@_sincronizando">
                        <span class="material-symbols-rounded">@(_sincronizando ? "sync" : "cloud_sync")</span>
                    </button>
                }
                <a href="/repartidor/historial" class="icon-btn" title="Historial">
                    <span class="material-symbols-rounded">history</span>
                </a>
            }
        </div>
    </div>

    <!-- ══ ROUTER DE VISTAS ══════════════════════════════════════════════ -->

    @if (_vista == Vista.Home)
    {
        <!-- ── HOME: selector de acción ────────────────────────────────── -->
        <div class="jhome-container">
            <p class="jhome-subtitle">¿Qué vas a hacer?</p>

            @if (_secciones.Count > 0)
            {
                <button class="jhome-btn stocks" @onclick="() => _vista = Vista.Stocks">
                    <span class="material-symbols-rounded jhome-icon-stocks">inventory_2</span>
                    <div class="jhome-btn-body">
                        <span class="jhome-btn-titulo">Stocks de reparto</span>
                        <span class="jhome-btn-sub">Define cuánto llevas por vuelta y sección</span>
                    </div>
                    <span class="material-symbols-rounded jhome-chevron">chevron_right</span>
                </button>
            }

            <button class="jhome-btn reparto" @onclick="() => _vista = Vista.Reparto">
                <span class="material-symbols-rounded jhome-icon-reparto">delivery_dining</span>
                <div class="jhome-btn-body">
                    <span class="jhome-btn-titulo">Hoja de reparto</span>
                    <span class="jhome-btn-sub">Registra entregas y devoluciones por cliente</span>
                </div>
                <span class="material-symbols-rounded jhome-chevron">chevron_right</span>
            </button>
        </div>
    }
    else if (_vista == Vista.Stocks)
    {
        <!-- ── STOCKS: carga por sección/vuelta ──────────────────────── -->
        <div class="jstocks-container">

            @if (!(Estado.Jornada?.Rondas.Count > 0))
            {
                <div class="empty-state" style="padding:40px 0;">
                    <span class="material-symbols-rounded">route</span>
                    <p>No hay vueltas configuradas en esta jornada.</p>
                </div>
            }
            else
            {
                <!-- Selector de vuelta (stocks siempre son por vuelta específica) -->
                <div class="jstocks-vuelta-bar">
                    <span class="jstocks-vuelta-label">Vuelta:</span>
                    @foreach (var ronda in Estado.Jornada!.Rondas)
                    {
                        var rId = ronda.Id;
                        <button class="hoja-vuelta-chip @(_hojaRondaId == rId ? "on" : "")"
                                @onclick="() => _hojaRondaId = rId">@ronda.Etiqueta</button>
                    }
                </div>

                @if (!_hojaRondaId.HasValue)
                {
                    <div style="padding:20px 16px;text-align:center;color:var(--gray-muted);font-size:13px;">
                        Selecciona una vuelta para editar sus stocks.
                    </div>
                }
                else if (_secciones.Count == 0)
                {
                    <div class="empty-state" style="padding:40px 0;">
                        <span class="material-symbols-rounded">map</span>
                        <p>No hay secciones configuradas para este negocio.</p>
                    </div>
                }
                else
                {
                    <div class="jstocks-secciones">
                        @foreach (var sec in _secciones.Where(s => s.Stocks.Count > 0))
                        {
                            <div class="jstocks-seccion-card">
                                <div class="jstocks-seccion-titulo">
                                    <span class="material-symbols-rounded" style="font-size:16px;color:var(--in,#6366F1);">map</span>
                                    <span>@sec.Nombre</span>
                                </div>
                                @foreach (var st in sec.Stocks.OrderBy(s => s.ProductoId))
                                {
                                    var prodDto  = Estado.Productos.FirstOrDefault(p => p.Id == st.ProductoId);
                                    var esGramaje = prodDto?.TipoMedida == TipoMedida.Gramaje;
                                    var valorAct  = GetStockParaRonda(_hojaRondaId!.Value, sec.Id, st.ProductoId, st.CantidadStock);
                                    var sItem     = new SeccionItem(st.ProductoId, st.ProductoNombre, esGramaje, valorAct, 0, 0);
                                    <div class="jstocks-prod-row">
                                        <span class="jstocks-prod-nombre">@st.ProductoNombre</span>
                                        <div class="jstocks-prod-right">
                                            <span class="jstocks-valor @(valorAct > 0 ? "activo" : "")">
                                                @valorAct.ToString("0.##")
                                                <span class="jstocks-unidad">@(esGramaje ? "kg" : "pzs")</span>
                                            </span>
                                            @if (!_soloLectura && Estado.Jornada?.Estado == JornadaEstado.Abierta)
                                            {
                                                <button class="jstocks-edit-btn"
                                                        @onclick="() => AbrirNumpadStock(_hojaRondaId!.Value, sec.Id, sItem)">
                                                    <span class="material-symbols-rounded">edit</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (!_secciones.Any(s => s.Stocks.Count > 0))
                        {
                            <div class="empty-state" style="padding:32px 0;">
                                <span class="material-symbols-rounded">inventory_2</span>
                                <p>Las secciones no tienen productos asignados.</p>
                            </div>
                        }
                    </div>

                    <!-- Conciliación de stocks (si ya hay entregas) -->
                    @if (HayEntregasEnVuelta())
                    {
                        <div style="padding:0 16px 8px;">
                            <div class="hoja-reparto-title" style="border-radius:12px 12px 0 0;">
                                <span class="material-symbols-rounded" style="font-size:18px;">balance</span>
                                <span style="flex:1;">Conciliación de esta vuelta</span>
                            </div>
                            @foreach (var sec in GetSeccionesResumenActuales())
                            {
                                <div class="hoja-seccion-card" style="border-radius:0;border-top:1px solid var(--gray-line);">
                                    <div class="hoja-seccion-title">
                                        <span class="material-symbols-rounded" style="font-size:15px;">map</span>
                                        <span>@sec.Nombre</span>
                                    </div>
                                    @foreach (var item in sec.Items)
                                    {
                                        var netoSec    = item.Entregado - item.Devuelto;
                                        var diff       = item.Stock - netoSec;
                                        var excede     = diff < 0;
                                        var exacto     = diff == 0;
                                        var estadoClass = excede ? "excede" : exacto ? "exacto" : "falta";
                                        <div class="hoja-prod-row">
                                            <span class="hoja-prod-nombre">@item.ProductoNombre</span>
                                            <div class="hoja-prod-stats">
                                                <div class="hoja-stat">
                                                    <span class="hoja-stat-label">Cargado</span>
                                                    <span class="hoja-stat-num">@item.Stock.ToString("0.##")</span>
                                                </div>
                                                <div class="hoja-stat">
                                                    <span class="hoja-stat-label">Entregado</span>
                                                    <span class="hoja-stat-num">@netoSec.ToString("0.##")</span>
                                                </div>
                                                <div class="hoja-stat @estadoClass">
                                                    <span class="hoja-stat-label">
                                                        @if (excede) { <span class="material-symbols-rounded" style="font-size:10px;vertical-align:middle;">warning</span>@(" Excede") }
                                                        else if (exacto) { <span class="material-symbols-rounded" style="font-size:10px;vertical-align:middle;">check_circle</span>@(" OK") }
                                                        else { <span class="material-symbols-rounded" style="font-size:10px;vertical-align:middle;">inventory_2</span>@(" Devolver") }
                                                    </span>
                                                    <span class="hoja-stat-num">@(exacto ? "—" : Math.Abs(diff).ToString("0.##"))</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Botón ir a repartir -->
                    @if (!_soloLectura && Estado.Jornada?.Estado == JornadaEstado.Abierta)
                    {
                        <div class="jstocks-footer">
                            <button class="jstocks-ir-btn" @onclick="() => _vista = Vista.Reparto">
                                <span class="material-symbols-rounded">delivery_dining</span>
                                Ir a repartir
                            </button>
                        </div>
                    }
                }
            }
        </div>
    }
    else
    {
        <!-- ── REPARTO: lista de clientes ────────────────────────────── -->
        <div class="jornada-search-bar">
            <span class="material-symbols-rounded">search</span>
            <input type="search" placeholder="Buscar cliente..."
                   @bind="_busquedaCliente" @bind:event="oninput"
                   class="jornada-search-input" />
            @if (!string.IsNullOrEmpty(_busquedaCliente))
            {
                <button class="jornada-search-clear" @onclick="() => _busquedaCliente = string.Empty">
                    <span class="material-symbols-rounded">close</span>
                </button>
            }
        </div>

        @if (Estado.Clientes.Any(c => !string.IsNullOrEmpty(c.Grupo)))
        {
            var gruposJornada = Estado.Clientes
                .Where(c => !string.IsNullOrEmpty(c.Grupo))
                .Select(c => c.Grupo!).Distinct().OrderBy(g => g).ToList();
            <div class="jornada-grupo-chips">
                <button class="jornada-grupo-chip @(_grupoFiltro == null ? "on" : "")"
                        @onclick="() => _grupoFiltro = null">Todos</button>
                @foreach (var g in gruposJornada)
                {
                    var gLocal = g;
                    <button class="jornada-grupo-chip @(_grupoFiltro == gLocal ? "on" : "")"
                            @onclick="() => _grupoFiltro = (_grupoFiltro == gLocal ? null : gLocal)">@g</button>
                }
            </div>
        }
        @if (_grupoFiltro != null)
        {
            var clientesGrupoList = Estado.Clientes.Where(c => c.Grupo == _grupoFiltro).ToList();
            var (gBruto, gNeto, gEfect, _, _) = Estado.TotalesFiltrados(clientesGrupoList.Select(c => c.Id));
            <div class="jornada-grupo-banner">
                <span class="material-symbols-rounded" style="font-size:18px;">group</span>
                <span>@_grupoFiltro · @clientesGrupoList.Count cliente@(clientesGrupoList.Count == 1 ? "" : "s")</span>
                <div style="margin-left:auto;display:flex;gap:12px;font-size:12px;flex-wrap:wrap;">
                    <span>Bruto: <strong class="tabnum text-em">@gBruto.ToString("C0", _mx)</strong></span>
                    <span>Neto: <strong class="tabnum text-vi">@gNeto.ToString("C0", _mx)</strong></span>
                    <span>Efectivo: <strong class="tabnum text-in">@gEfect.ToString("C0", _mx)</strong></span>
                </div>
            </div>
        }

        <div class="jornada-client-list">
            @{
                var clientesFiltrados = ClientesFiltrados.ToList();
            }
            @foreach (var cliente in clientesFiltrados)
            {
                var excluido = Estado.Exclusiones.TryGetValue(cliente.Id, out var ex) && ex.ExcluidoDeEfectivo;
                var (cliNeto, _) = Estado.TotalesCliente(cliente.Id);
                var chips = GetChipsCliente(cliente.Id);
                <div class="jornada-client-card @(excluido ? "excluido" : "")"
                     @onclick="() => IrACliente(cliente.Id)">
                    <div class="jornada-card-body">
                        <div class="jornada-card-nombre">@cliente.Nombre</div>
                        <div class="jornada-card-chips">
                            @if (chips.Count == 0)
                            {
                                <span class="jornada-card-chip sin-datos">Sin capturar</span>
                            }
                            else
                            {
                                @foreach (var chip in chips)
                                {
                                    <span class="jornada-card-chip">@chip</span>
                                }
                            }
                        </div>
                    </div>
                    <div class="jornada-card-right">
                        <span class="jornada-card-monto">@cliNeto.ToString("C", _mx)</span>
                        @if (excluido && ex != null)
                        {
                            <span class="jornada-card-excl">@GetMetodoPagoLabel(ex.MetodoPagoAlternativo)</span>
                        }
                    </div>
                    <span class="material-symbols-rounded" style="color:var(--gray-muted);font-size:18px;flex-shrink:0;">chevron_right</span>
                </div>
            }

            @if (Estado.Clientes.Count == 0)
            {
                <div class="empty-state">
                    <span class="material-symbols-rounded">group</span>
                    <p>No hay clientes con entrega programada para hoy.</p>
                </div>
            }
            else if (clientesFiltrados.Count == 0)
            {
                <div class="empty-state">
                    <span class="material-symbols-rounded">search_off</span>
                    <p>No se encontraron clientes con ese nombre.</p>
                </div>
            }
        </div>
    }
}

<!-- Numpad flotante para editar stock de sección por ronda -->
<NumpadDialog @bind-Visible="_stockNumpadVisible"
              Titulo="@_stockNumpadTitulo"
              ValorInicial="@_stockNumpadValorInicial"
              PermiteDecimal="@_stockNumpadDecimal"
              OnConfirmar="OnStockNumpadConfirmar" />

@code {
    [Parameter] public int? JornadaId { get; set; }

    private static readonly System.Globalization.CultureInfo _mx =
        System.Globalization.CultureInfo.GetCultureInfo("es-MX");

    private bool   _cargando        = true;
    private bool   _soloLectura;
    private bool   _puedeAbrir;
    private bool   _initialized;
    private int    _negocioId;
    private string _saveText        = "Guardado ✓";
    private string _saveClass       = "save-ok";
    private string  _busquedaCliente = string.Empty;
    private bool    _mostrarDinero   = true;
    private string? _grupoFiltro;
    private bool    _sincronizando;   // descargando datos desde la nube
    private bool    _sinDatosLocales; // offline y sin caché disponible
    private List<SeccionDto>       _secciones       = new();
    private List<GrupoProductoDto> _gruposProducto  = new();
    private int?    _hojaRondaId;      // null = todas las vueltas

    // Múltiples jornadas por día
    private List<JornadaDto>? _misJornadasHoy;
    private bool               _mostrarPickerJornadas;

    // Vista activa (solo ruta repartidor)
    private enum Vista { Home, Stocks, Reparto }
    private Vista _vista = Vista.Home;

    // Numpad inline para editar stock de sección por ronda
    private bool    _stockNumpadVisible;
    private string  _stockNumpadTitulo = "";
    private decimal? _stockNumpadValorInicial;
    private bool    _stockNumpadDecimal;
    private int     _stockNumpadRondaId;
    private int     _stockNumpadSeccionId;
    private int     _stockNumpadProductoId;

    private IEnumerable<CustomerDto> ClientesFiltrados =>
        Estado.Clientes
            .Where(c => string.IsNullOrWhiteSpace(_busquedaCliente) || c.Nombre.Contains(_busquedaCliente, StringComparison.OrdinalIgnoreCase))
            .Where(c => _grupoFiltro == null || c.Grupo == _grupoFiltro);

    // Stocks por ronda: clave "{rondaId}_{seccionId}_{productoId}" → cantidad cargada
    private Dictionary<string, decimal> _stocksRonda = new();

    private record ProductTotal(string Nombre, decimal Total, bool EsGramaje, bool EsGrupo = false);
    private record SeccionItem(int ProductoId, string ProductoNombre, bool EsGramaje, decimal Stock, decimal Entregado, decimal Devuelto);
    private record SeccionResumen(int Id, string Nombre, List<SeccionItem> Items);

    private List<ProductTotal> GetTotalesProductos()
    {
        var clientes = _grupoFiltro == null
            ? Estado.Clientes
            : Estado.Clientes.Where(c => c.Grupo == _grupoFiltro).ToList();

        // Si hay grupos configurados, mostrar totales por grupo
        if (_gruposProducto.Count > 0)
        {
            var result = new List<ProductTotal>();
            var grupoMap = _gruposProducto.ToDictionary(g => g.Id);

            foreach (var grupo in _gruposProducto)
            {
                var productosGrupo = Estado.Productos.Where(p => p.GrupoProductoId == grupo.Id).ToList();
                if (productosGrupo.Count == 0) continue;

                decimal totalGrupo = 0;
                bool esGramaje = productosGrupo.Any(p => p.TipoMedida == TipoMedida.Gramaje);
                foreach (var prod in productosGrupo)
                    foreach (var cli in clientes)
                        foreach (var ronda in Estado.Jornada?.Rondas ?? new())
                            totalGrupo += Estado.GetOrCreate(ronda.Id, cli.Id, prod.Id).Entregado;

                if (totalGrupo > 0)
                    result.Add(new(grupo.Nombre, totalGrupo, esGramaje, EsGrupo: true));
            }

            // Productos sin grupo
            foreach (var prod in Estado.Productos.Where(p => p.GrupoProductoId == null))
            {
                decimal total = 0;
                foreach (var cli in clientes)
                    foreach (var ronda in Estado.Jornada?.Rondas ?? new())
                        total += Estado.GetOrCreate(ronda.Id, cli.Id, prod.Id).Entregado;
                if (total > 0)
                    result.Add(new(prod.Nombre, total, prod.TipoMedida == TipoMedida.Gramaje));
            }
            return result;
        }

        // Sin grupos: mostrar por producto individual (comportamiento anterior)
        var individual = new List<ProductTotal>();
        foreach (var prod in Estado.Productos)
        {
            decimal total = 0;
            foreach (var cli in clientes)
                foreach (var ronda in Estado.Jornada?.Rondas ?? new())
                    total += Estado.GetOrCreate(ronda.Id, cli.Id, prod.Id).Entregado;
            if (total > 0)
                individual.Add(new(prod.Nombre, total, prod.TipoMedida == TipoMedida.Gramaje));
        }
        return individual;
    }

    // Devuelve el stock para una ronda específica, con fallback al stock base de la sección.
    private decimal GetStockParaRonda(int rondaId, int seccionId, int productoId, decimal stockBase)
    {
        var key = $"{rondaId}_{seccionId}_{productoId}";
        return _stocksRonda.TryGetValue(key, out var v) ? v : stockBase;
    }

    private List<SeccionResumen> GetSeccionesResumenActuales()
        => _hojaRondaId.HasValue ? GetSeccionesResumen(_hojaRondaId) : new();

    private bool HayEntregasEnVuelta()
        => _hojaRondaId.HasValue &&
           GetSeccionesResumen(_hojaRondaId).Any(s => s.Items.Any(i => i.Entregado > 0 || i.Devuelto > 0));

    private List<SeccionResumen> GetSeccionesResumen(int? rondaId = null)
    {
        var todasRondas = Estado.Jornada?.Rondas ?? new();
        var rondas = rondaId.HasValue
            ? todasRondas.Where(r => r.Id == rondaId.Value).ToList()
            : todasRondas;

        var resumen = new List<SeccionResumen>();
        foreach (var sec in _secciones)
        {
            var clienteIds = Estado.Clientes
                .Where(c => c.SeccionId == sec.Id)
                .Select(c => c.Id).ToHashSet();
            if (clienteIds.Count == 0 && sec.Stocks.Count == 0) continue;

            var items = sec.Stocks.Select(stock =>
            {
                // Stock efectivo: suma por ronda (cada ronda puede tener su propio valor editado)
                decimal cantidadStock = rondaId.HasValue
                    ? GetStockParaRonda(rondaId.Value, sec.Id, stock.ProductoId, stock.CantidadStock)
                    : todasRondas.Sum(r => GetStockParaRonda(r.Id, sec.Id, stock.ProductoId, stock.CantidadStock));

                decimal entregado = 0, devuelto = 0;
                foreach (var cliId in clienteIds)
                    foreach (var ronda in rondas)
                    {
                        var c = Estado.GetOrCreate(ronda.Id, cliId, stock.ProductoId);
                        entregado += c.Entregado;
                        devuelto  += c.Devuelto;
                    }
                var prodDto = Estado.Productos.FirstOrDefault(p => p.Id == stock.ProductoId);
                return new SeccionItem(
                    stock.ProductoId,
                    stock.ProductoNombre,
                    prodDto?.TipoMedida == TipoMedida.Gramaje,
                    cantidadStock, entregado, devuelto);
            }).Where(i => i.Stock > 0 || i.Entregado > 0 || i.Devuelto > 0).ToList();

            if (items.Count > 0)
                resumen.Add(new SeccionResumen(sec.Id, sec.Nombre, items));
        }
        return resumen;
    }

    private void AbrirNumpadStock(int rondaId, int seccionId, SeccionItem item)
    {
        _stockNumpadRondaId    = rondaId;
        _stockNumpadSeccionId  = seccionId;
        _stockNumpadProductoId = item.ProductoId;
        _stockNumpadTitulo     = $"Carga · {item.ProductoNombre}";
        _stockNumpadValorInicial = item.Stock;
        _stockNumpadDecimal    = item.EsGramaje;
        _stockNumpadVisible    = true;
    }

    private async Task OnStockNumpadConfirmar(decimal valor)
    {
        _stocksRonda[$"{_stockNumpadRondaId}_{_stockNumpadSeccionId}_{_stockNumpadProductoId}"] = valor;
        await GuardarStocksRondaAsync();
        StateHasChanged();
    }

    private async Task GuardarStocksRondaAsync()
    {
        if (Estado.Jornada?.TenantId is not > 0) return;
        var negId = Estado.Jornada.TenantId;
        var snap = await LocalData.GetSnapshotAsync(negId) ?? new JornadaSnapshot
        {
            Jornada   = Estado.GetSnapshotJornada(),
            Productos = Estado.Productos,
            Clientes  = Estado.Clientes
        };
        snap.StocksRonda = _stocksRonda;
        await LocalData.SaveSnapshotAsync(negId, snap);
    }

    protected override async Task OnInitializedAsync()
    {
        Estado.OnChange += StateHasChanged;
        OfflineSync.OnConnectivityChanged += OnConectividadCambia;
        OfflineSync.OnSynced += OnDatosSincronizados;
        OfflineSync.OnNegocioSynced += OnNegocioActualizado;

        var user = await AuthSvc.GetCurrentUser();
        _negocioId   = user?.NegocioIds.FirstOrDefault() ?? 0;
        _soloLectura = user?.Rol == UserRole.Supervisor;
        _puedeAbrir  = user?.Rol == UserRole.Repartidor || user?.Rol == UserRole.Admin;

        // Gate de permiso: Supervisor sin VerHojaReparto no puede acceder
        if (user?.Rol == UserRole.Supervisor && _negocioId > 0 && !user.PuedeVerHojaReparto(_negocioId))
        {
            Nav.NavigateTo("/");
            return;
        }

        _initialized = true;

        await CargarSiNecesario();

        // Cargar stocks por ronda desde snapshot (datos operativos locales)
        if (_negocioId > 0 && !JornadaId.HasValue)
        {
            var snapStocks = await LocalData.GetSnapshotAsync(_negocioId);
            if (snapStocks?.StocksRonda != null)
                _stocksRonda = snapStocks.StocksRonda;
        }

        // Cargar lista de todas las jornadas de hoy (soporte múltiples jornadas)
        if (_negocioId > 0 && !JornadaId.HasValue && OfflineSync.IsOnline)
        {
            try
            {
                _misJornadasHoy = await Api.GetMisJornadasHoyAsync(_negocioId);
                if (Estado.Jornada == null)
                {
                    if (_misJornadasHoy?.Count == 1)
                    {
                        // Auto-seleccionar la única jornada
                        var full = await Api.GetJornadaByIdAsync(_misJornadasHoy[0].Id);
                        if (full != null)
                        {
                            var prods = await Api.GetProductosAsync(_negocioId) ?? new();
                            var clis  = (await Api.GetClientesAsync(_negocioId) ?? new()).Where(TieneEntregaHoy).ToList();
                            Estado.Cargar(full, prods, clis);
                            await LocalData.SaveSnapshotAsync(_negocioId, new JornadaSnapshot
                            { Jornada = full, Productos = prods, Clientes = clis });
                        }
                    }
                    else if ((_misJornadasHoy?.Count ?? 0) > 1)
                        _mostrarPickerJornadas = true;
                }
            }
            catch { }
        }

        _cargando = false;

        // Cargar datos del negocio (grupos, secciones) y arrancar sync periódico
        if (_negocioId > 0 && !JornadaId.HasValue)
        {
            await CargarDatosNegocioAsync();
            OfflineSync.StartPeriodicSync(_negocioId);
        }

        // Si hay ops pendientes, reflejar estado en el indicador
        var pending = await OfflineSync.PendingCountAsync();
        if (pending > 0 && !JornadaId.HasValue)
        {
            _saveText  = $"{pending} cambio(s) pendiente(s)";
            _saveClass = "save-pending";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized) return;
        await CargarSiNecesario();
    }

    private async Task CargarSiNecesario()
    {
        if (JornadaId.HasValue)
        {
            if (Estado.Jornada?.Id != JornadaId.Value)
            {
                Estado.Limpiar();
                _cargando = true;
                StateHasChanged();
                await CargarJornada();
                _cargando = false;
            }
        }
        else if (!Estado.Cargado && _negocioId > 0)
        {
            await CargarJornada();
        }
    }

    private bool _loadedFromCache;

    private async Task CargarJornada()
    {
        _sinDatosLocales = false;

        if (JornadaId.HasValue)
        {
            await CargarDesdeApi();
            return;
        }

        // 1. Intentar local primero (no requiere red → instante)
        bool tieneLocal = await CargarDesdeLocal();

        if (tieneLocal)
        {
            // Datos disponibles al instante; API en segundo plano si hay conexión
            _ = RefrescarDesdeApiAsync();
        }
        else
        {
            // Sin caché → intentar API (primera vez u otro dispositivo)
            await CargarDesdeApi();

            // Si sigue sin jornada y no hay red → indicar "sin datos locales"
            if (!Estado.Cargado)
                _sinDatosLocales = !OfflineSync.IsOnline;
        }
    }

    private async Task<bool> CargarDesdeLocal()
    {
        if (_negocioId == 0) return false;
        try
        {
            var snap = await LocalData.GetSnapshotAsync(_negocioId);
            if (snap?.Jornada?.Id is not > 0) return false;

            // Aceptar si es de hoy O si la jornada sigue abierta (tolerancia a
            // diferencias de zona horaria y reinicios entre días)
            var esDeHoy    = snap.Jornada.Fecha == DateOnly.FromDateTime(DateTime.Today);
            var estaAbierta = snap.Jornada.Estado == JornadaEstado.Abierta;
            if (!esDeHoy && !estaAbierta) return false;

            var clientes = snap.Clientes.Any()
                ? snap.Clientes.Where(TieneEntregaHoy).ToList()
                : new();

            Estado.Cargar(snap.Jornada, snap.Productos, clientes);
            _loadedFromCache = true;
            return true;
        }
        catch { return false; }
    }

    private async Task CargarDesdeApi()
    {
        try
        {
            JornadaDto? jornada;
            if (JornadaId.HasValue)
            {
                jornada = await Api.GetJornadaByIdAsync(JornadaId.Value);
                if (jornada != null) _negocioId = jornada.TenantId;
            }
            else
            {
                jornada = await Api.GetJornadaHoyAsync(_negocioId);
            }

            if (jornada != null)
            {
                var productos = await Api.GetProductosAsync(_negocioId) ?? new();
                var clientes  = (await Api.GetClientesAsync(_negocioId) ?? new())
                                .Where(c => JornadaId.HasValue || TieneEntregaHoy(c)).ToList();

                if (!JornadaId.HasValue)
                    await LocalData.SaveSnapshotAsync(_negocioId, new JornadaSnapshot
                    {
                        Jornada   = jornada,
                        Productos = productos,
                        Clientes  = clientes
                    });

                Estado.Cargar(jornada, productos, clientes);
                _loadedFromCache  = false;
                _sinDatosLocales  = false;
            }
        }
        catch { }
    }

    /// <summary>Descarga datos actualizados en segundo plano y actualiza el snapshot local.</summary>
    private async Task RefrescarDesdeApiAsync()
    {
        if (_negocioId == 0) return;
        try
        {
            // Si ya hay una jornada cargada, refrescar esa específica; si no, la más reciente del día
            JornadaDto? jornada = Estado.Jornada?.Id > 0
                ? await Api.GetJornadaByIdAsync(Estado.Jornada.Id)
                : await Api.GetJornadaHoyAsync(_negocioId);
            if (jornada == null) return;

            var productos = await Api.GetProductosAsync(_negocioId) ?? new();
            var clientes  = (await Api.GetClientesAsync(_negocioId) ?? new())
                            .Where(TieneEntregaHoy).ToList();

            await LocalData.SaveSnapshotAsync(_negocioId, new JornadaSnapshot
            {
                Jornada   = jornada,
                Productos = productos,
                Clientes  = clientes
            });

            var pending = await LocalData.CountPendingAsync();
            if (pending == 0)
            {
                Estado.Cargar(jornada, productos, clientes);
                _loadedFromCache = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    /// <summary>Carga una jornada específica seleccionada desde el picker.</summary>
    private async Task SeleccionarJornada(JornadaDto j)
    {
        _mostrarPickerJornadas = false;
        _cargando = true;
        StateHasChanged();
        try
        {
            var jornada = await Api.GetJornadaByIdAsync(j.Id);
            if (jornada != null)
            {
                var prods = await Api.GetProductosAsync(_negocioId) ?? new();
                var clis  = (await Api.GetClientesAsync(_negocioId) ?? new()).Where(TieneEntregaHoy).ToList();
                Estado.Limpiar();
                Estado.Cargar(jornada, prods, clis);
                // Recuperar stocks específicos de esta jornada si el snapshot coincide
                var snap = await LocalData.GetSnapshotAsync(_negocioId);
                _stocksRonda = (snap?.Jornada?.Id == jornada.Id && snap.StocksRonda != null)
                    ? snap.StocksRonda : new();
                await LocalData.SaveSnapshotAsync(_negocioId, new JornadaSnapshot
                { Jornada = jornada, Productos = prods, Clientes = clis, StocksRonda = _stocksRonda });
            }
        }
        catch { Snackbar.Add("Error al cargar la jornada", Severity.Error); }
        _cargando = false;
    }

    /// <summary>Descarga TODOS los datos desde la nube y los persiste en local. Botón manual.</summary>
    private async Task SincronizarDatosAsync()
    {
        if (_negocioId == 0 || _sincronizando) return;
        _sincronizando   = true;
        _sinDatosLocales = false;
        StateHasChanged();
        try
        {
            // Descargar datos maestros y jornada en paralelo
            var negSnap = OfflineSync.SyncNegocioDataAsync(_negocioId);
            var jornadaTask = Api.GetJornadaHoyAsync(_negocioId);
            await Task.WhenAll(negSnap, jornadaTask);

            var jornada = jornadaTask.Result;

            if (jornada != null)
            {
                var negocioSnap = await LocalData.GetNegocioSnapshotAsync(_negocioId);
                var productos = negocioSnap?.Productos ?? await Api.GetProductosAsync(_negocioId) ?? new();
                var clientesTodos = negocioSnap?.Clientes ?? await Api.GetClientesAsync(_negocioId) ?? new();
                var clientes = clientesTodos.Where(TieneEntregaHoy).ToList();

                await LocalData.SaveSnapshotAsync(_negocioId, new JornadaSnapshot
                {
                    Jornada   = jornada,
                    Productos = productos,
                    Clientes  = clientesTodos
                });

                // Actualizar listas de grupos y secciones en memoria
                if (negocioSnap != null)
                {
                    _gruposProducto = negocioSnap.GruposProducto;
                    _secciones      = negocioSnap.Secciones;
                }

                await OfflineSync.ProcessQueueAsync();
                Estado.Cargar(jornada, productos, clientes);
                _loadedFromCache = false;
                Snackbar.Add("Datos sincronizados ✓", Severity.Success);
            }
            else
            {
                // Sin jornada, pero actualizar datos maestros igual
                var negocioSnap = await LocalData.GetNegocioSnapshotAsync(_negocioId);
                if (negocioSnap != null)
                {
                    _gruposProducto = negocioSnap.GruposProducto;
                    _secciones      = negocioSnap.Secciones;
                }
                Snackbar.Add("No hay jornada activa hoy", Severity.Info);
            }
        }
        catch
        {
            Snackbar.Add("Error de conexión al sincronizar", Severity.Error);
        }
        finally
        {
            _sincronizando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Carga grupos y secciones: primero desde local, luego sincroniza en segundo plano si hay red.</summary>
    private async Task CargarDatosNegocioAsync()
    {
        if (_negocioId == 0) return;
        var snap = await LocalData.GetNegocioSnapshotAsync(_negocioId);
        if (snap != null)
        {
            _gruposProducto = snap.GruposProducto;
            _secciones      = snap.Secciones;
        }

        // Si es gerente viendo jornada ajena → ir directamente a reparto
        if (JornadaId.HasValue)
            _vista = Vista.Reparto;
        // Si no hay secciones configuradas → ir directamente a reparto (sin pantalla de stocks)
        else if (_secciones.Count == 0)
            _vista = Vista.Reparto;

        // Auto-seleccionar primera vuelta cuando hay secciones
        if (_secciones.Count > 0 && _hojaRondaId == null)
            _hojaRondaId = Estado.Jornada?.Rondas.FirstOrDefault()?.Id;

        // Sincronizar en segundo plano si hay internet
        if (OfflineSync.IsOnline)
            _ = OfflineSync.SyncNegocioDataAsync(_negocioId);
    }

    private void OnNegocioActualizado()
    {
        _ = InvokeAsync(async () =>
        {
            var snap = await LocalData.GetNegocioSnapshotAsync(_negocioId);
            if (snap != null)
            {
                _gruposProducto = snap.GruposProducto;
                _secciones      = snap.Secciones;
                StateHasChanged();
            }
        });
    }

    private bool TieneEntregaHoy(CustomerDto c)
    {
        var hoy = (int)DateTime.Today.DayOfWeek;
        int bit = hoy == 0 ? 64 : (1 << (hoy - 1));
        return (c.DiasEntrega & bit) != 0 || c.DiasEntrega == 0;
    }

    private void IrACliente(int clienteId)
        => Nav.NavigateTo(JornadaId.HasValue
            ? $"/jornada/{JornadaId}/cliente/{clienteId}"
            : $"/repartidor/jornada/cliente/{clienteId}");

    private List<string> GetChipsCliente(int clienteId)
    {
        var chips = new List<string>();
        foreach (var prod in Estado.Productos)
        {
            decimal totalEnt = 0;
            foreach (var ronda in Estado.Jornada?.Rondas ?? new())
                totalEnt += Estado.GetOrCreate(ronda.Id, clienteId, prod.Id).Entregado;
            if (totalEnt > 0)
            {
                var lbl = prod.TipoMedida == TipoMedida.Gramaje
                    ? $"{totalEnt:0.##} kg {prod.Nombre}"
                    : $"{totalEnt:0.##} {prod.Nombre}";
                chips.Add(lbl);
            }
        }
        return chips;
    }

    private async Task AgregarRonda()
    {
        var dialog = await Dialog.ShowAsync<AgregarRondaDialog>("Nueva Vuelta");
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is string etiqueta)
        {
            var resp = await Api.AddRondaAsync(Estado.Jornada!.Id, new AddRondaRequest { Etiqueta = etiqueta });
            if (resp.IsSuccessStatusCode)
            {
                var nueva = await resp.Content.ReadFromJsonAsync<RondaDto>();
                if (nueva != null) { Estado.Jornada!.Rondas.Add(nueva); Estado.Notificar(); }
                Snackbar.Add("Vuelta agregada", Severity.Success);
            }
        }
    }

    private async Task CerrarJornada()
    {
        if (!OfflineSync.IsOnline)
        {
            Snackbar.Add("Necesitas conexión para cerrar la jornada", Severity.Warning);
            return;
        }
        var (_, _, efect, _, _) = Estado.Totales();
        var confirm = await Dialog.ShowMessageBox("Cerrar jornada",
            $"Efectivo a rendir: {efect.ToString("C", _mx)}. ¿Confirmar cierre?",
            yesText: "Confirmar cierre", cancelText: "Cancelar");
        if (confirm != true) return;
        try
        {
            var resp = await Api.CerrarJornadaAsync(Estado.Jornada!.Id);
            if (resp.IsSuccessStatusCode)
            {
                Estado.Jornada.Estado = JornadaEstado.Cerrada;
                Estado.Notificar();
                // Actualizar snapshot local con el nuevo estado
                await LocalData.SaveSnapshotAsync(_negocioId, new JornadaSnapshot
                {
                    Jornada   = Estado.GetSnapshotJornada(),
                    Productos = Estado.Productos,
                    Clientes  = Estado.Clientes
                });
                Snackbar.Add($"Jornada cerrada. Efectivo: {efect.ToString("C", _mx)}", Severity.Success);
            }
        }
        catch { Snackbar.Add("Error de conexión al cerrar jornada", Severity.Error); }
    }

    private async Task AbrirJornada()
    {
        if (!OfflineSync.IsOnline)
        {
            Snackbar.Add("Necesitas conexión para abrir una jornada", Severity.Warning);
            return;
        }
        try
        {
            var resp = await Api.AbrirJornadaAsync(new OpenJornadaRequest
            {
                TenantId   = _negocioId,
                LocalFecha = DateOnly.FromDateTime(DateTime.Today)
            });
            if (resp.IsSuccessStatusCode)
            {
                var nueva = await resp.Content.ReadFromJsonAsync<JornadaDto>();
                if (nueva != null)
                {
                    _misJornadasHoy ??= new();
                    _misJornadasHoy.Add(nueva);
                    await SeleccionarJornada(nueva);
                    Snackbar.Add("Jornada abierta", Severity.Success);
                }
            }
            else
            {
                Snackbar.Add("No se pudo abrir la jornada", Severity.Error);
            }
        }
        catch { Snackbar.Add("Error de conexión al abrir jornada", Severity.Error); }
    }

    private static string GetMetodoPagoLabel(MetodoPago mp) => mp switch
    {
        MetodoPago.TarjetaCredito => "T. CRÉDITO",
        MetodoPago.TarjetaDebito  => "T. DÉBITO",
        MetodoPago.Transferencia  => "TRANSF.",
        _                         => "OTRO"
    };

    private void OnConectividadCambia()
    {
        if (!JornadaId.HasValue)
        {
            if (OfflineSync.IsOnline)
            {
                // Si estábamos en modo "sin datos", intentar cargar ahora que hay red
                if (_sinDatosLocales || !Estado.Cargado)
                    InvokeAsync(async () => { await CargarJornada(); StateHasChanged(); });
                else
                    _ = RefrescarDesdeApiAsync();
            }
            else
            {
                // Se perdió la conexión — actualizar indicadores en la UI
                InvokeAsync(StateHasChanged);
            }
        }
    }

    private async void OnDatosSincronizados()
    {
        // La cola se vació → ahora sí podemos tomar el estado del servidor
        _saveText  = "Sincronizado ✓";
        _saveClass = "save-ok";
        if (!JornadaId.HasValue)
            _ = RefrescarDesdeApiAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Estado.OnChange -= StateHasChanged;
        OfflineSync.OnConnectivityChanged -= OnConectividadCambia;
        OfflineSync.OnSynced -= OnDatosSincronizados;
        OfflineSync.OnNegocioSynced -= OnNegocioActualizado;
    }
}
