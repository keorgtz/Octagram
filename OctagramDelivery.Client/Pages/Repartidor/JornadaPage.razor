@page "/repartidor/jornada"
@page "/gerente/jornada/{JornadaId:int}"
@attribute [Authorize(Roles = $"{nameof(UserRole.Repartidor)},{nameof(UserRole.Gerente)},{nameof(UserRole.Supervisor)},{nameof(UserRole.Admin)}")]
@implements IDisposable
@inject ApiService Api
@inject AuthService AuthSvc
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Nav
@inject JornadaStateService Estado
@inject LocalDataService LocalData
@inject OfflineSyncService OfflineSync

<PageTitle>Jornada · TortiCloud</PageTitle>

@if (_loadedFromCache && !OfflineSync.IsOnline)
{
    <div style="background:#FEF3C7;border-bottom:1px solid #FDE68A;padding:8px 16px;display:flex;align-items:center;gap:8px;font-size:12px;color:#92400E;">
        <span class="material-symbols-rounded" style="font-size:16px;">wifi_off</span>
        Sin conexión — mostrando datos guardados localmente.
    </div>
}

@if (_cargando)
{
    <div style="display:flex;height:60vh;align-items:center;justify-content:center;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (Estado.Jornada == null)
{
    @if (_sinDatosLocales)
    {
        <!-- Sin datos locales: offline sin caché -->
        <div style="padding:32px 24px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px;">
            <span class="material-symbols-rounded" style="font-size:64px;color:var(--gray-muted);">cloud_off</span>
            <h2 style="color:var(--gray-dark);margin:0;">Sin datos locales</h2>
            <p style="color:var(--gray-muted);margin:0;max-width:280px;">
                No hay datos guardados en este dispositivo. Conéctate a internet y sincroniza.
            </p>
            @if (OfflineSync.IsOnline)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Rounded.CloudSync"
                           Disabled="_sincronizando"
                           OnClick="SincronizarDatosAsync"
                           Style="margin-top:4px;">
                    @(_sincronizando ? "Sincronizando…" : "Bajar datos de la nube")
                </MudButton>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Dense="true">Sin conexión a internet</MudAlert>
            }
        </div>
    }
    else
    {
        <!-- Sin jornada activa (confirmado por la API) -->
        <div style="padding:32px 24px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:12px;">
            <span class="material-symbols-rounded" style="font-size:64px;color:var(--gray-muted);">delivery_dining</span>
            <h2 style="color:var(--gray-dark);margin:0;">Sin jornada activa</h2>
            <p style="color:var(--gray-muted);margin:0;">No hay una jornada abierta para hoy.</p>
            @if (_negocioId > 0 && !_soloLectura && _puedeAbrir)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AbrirJornada"
                           StartIcon="@Icons.Material.Rounded.PlayCircle" Style="margin-top:4px;">
                    Abrir Jornada de Hoy
                </MudButton>
            }
            else if (!_puedeAbrir)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Rounded.ArrowBack"
                           OnClick='() => Nav.NavigateTo("/gerente/jornadas")'>
                    Ver jornadas activas
                </MudButton>
            }
            else if (_negocioId == 0)
            {
                <MudAlert Severity="Severity.Warning">No tienes un negocio asignado.</MudAlert>
            }
        </div>
    }
}
else
{
    <div class="jornada-mobile-header">
        <div class="jornada-mobile-meta">
            @if (JornadaId.HasValue)
            {
                <button class="icon-btn" @onclick='() => Nav.NavigateTo("/gerente/jornadas")'>
                    <span class="material-symbols-rounded">arrow_back</span>
                </button>
            }
            <div style="min-width:0;flex:1;">
                <div class="fw-700" style="font-size:15px;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                    @(JornadaId.HasValue ? Estado.Jornada.DriverNombre : Estado.Jornada.TenantNombre)
                </div>
                <div class="text-muted" style="font-size:12px;margin-top:2px;">
                    @if (JornadaId.HasValue)
                    {
                        <span>@Estado.Jornada.TenantNombre · @Estado.Jornada.Fecha.ToString("d 'de' MMMM", _mx)</span>
                    }
                    else
                    {
                        @Estado.Jornada.Fecha.ToString("dddd d 'de' MMMM", _mx)
                    }
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
                @if (_soloLectura)
                {
                    <span class="badge-solo-lectura">
                        <span class="material-symbols-rounded" style="font-size:13px;">visibility</span>
                        Solo lectura
                    </span>
                }
                else if (Estado.Jornada.Estado == JornadaEstado.Abierta)
                {
                    <MudButton StartIcon="@Icons.Material.Rounded.CheckCircleOutline"
                               Variant="Variant.Filled" Color="Color.Success"
                               Size="Size.Small" OnClick="CerrarJornada">
                        Cerrar
                    </MudButton>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">Cerrada</MudChip>
                }
            </div>
        </div>

        @{
            var clientesGrupoIds = _grupoFiltro == null
                ? Estado.Clientes.Select(c => c.Id)
                : Estado.Clientes.Where(c => c.Grupo == _grupoFiltro).Select(c => c.Id);
            var (bruto, neto, efect, _, _) = Estado.TotalesFiltrados(clientesGrupoIds);
        }
        <div class="jornada-mobile-totales">
            @if (_mostrarDinero)
            {
                <div class="jornada-mini-total">
                    <span class="jornada-mini-label">Bruto</span>
                    <span class="jornada-mini-value text-em">@bruto.ToString("C", _mx)</span>
                </div>
                <div class="jornada-mini-total">
                    <span class="jornada-mini-label">Neto</span>
                    <span class="jornada-mini-value text-vi">@neto.ToString("C", _mx)</span>
                </div>
                <div class="jornada-mini-total">
                    <span class="jornada-mini-label">Efectivo</span>
                    <span class="jornada-mini-value text-in">@efect.ToString("C", _mx)</span>
                </div>
            }
            else
            {
                var totalesProd = GetTotalesProductos();
                if (totalesProd.Count == 0)
                {
                    <div class="jornada-mini-total">
                        <span class="jornada-mini-label">Sin entregas</span>
                        <span class="jornada-mini-value" style="color:var(--gray-muted);">—</span>
                    </div>
                }
                else
                {
                    foreach (var pt in totalesProd)
                    {
                        <div class="jornada-mini-total">
                            <span class="jornada-mini-label">@pt.Nombre</span>
                            <span class="jornada-mini-value" style="color:var(--gray-dark);">
                                @(pt.EsGramaje ? $"{pt.Total:0.##} kg" : $"{pt.Total:0.##} pzs")
                            </span>
                        </div>
                    }
                }
            }
            <button class="jornada-totales-toggle"
                    @onclick="() => _mostrarDinero = !_mostrarDinero"
                    title="@(_mostrarDinero ? "Ver cantidades" : "Ver dinero")">
                <span class="material-symbols-rounded">
                    @(_mostrarDinero ? "straighten" : "attach_money")
                </span>
            </button>
        </div>

        <div style="display:flex;align-items:center;gap:8px;">
            @if (!_soloLectura)
            {
                <span class="save-indicator @_saveClass" style="flex:1;font-size:11px;">@_saveText</span>
                @if (Estado.Jornada.Estado == JornadaEstado.Abierta)
                {
                    <button class="icon-btn" title="Agregar vuelta" @onclick="AgregarRonda">
                        <span class="material-symbols-rounded">add_circle</span>
                    </button>
                }
            }
            else
            {
                <span style="flex:1;"></span>
            }
            @if (!JornadaId.HasValue)
            {
                @if (OfflineSync.IsOnline)
                {
                    <button class="icon-btn @(_sincronizando ? "syncing" : "")"
                            title="@(_sincronizando ? "Sincronizando…" : "Sincronizar datos desde la nube")"
                            @onclick="SincronizarDatosAsync" disabled="@_sincronizando">
                        <span class="material-symbols-rounded">@(_sincronizando ? "sync" : "cloud_sync")</span>
                    </button>
                }
                <a href="/repartidor/historial" class="icon-btn" title="Historial">
                    <span class="material-symbols-rounded">history</span>
                </a>
            }
        </div>
    </div>

    <div class="jornada-search-bar">
        <span class="material-symbols-rounded">search</span>
        <input type="search" placeholder="Buscar cliente..."
               @bind="_busquedaCliente" @bind:event="oninput"
               class="jornada-search-input" />
        @if (!string.IsNullOrEmpty(_busquedaCliente))
        {
            <button class="jornada-search-clear" @onclick="() => _busquedaCliente = string.Empty">
                <span class="material-symbols-rounded">close</span>
            </button>
        }
    </div>

    @if (Estado.Clientes.Any(c => !string.IsNullOrEmpty(c.Grupo)))
    {
        var gruposJornada = Estado.Clientes
            .Where(c => !string.IsNullOrEmpty(c.Grupo))
            .Select(c => c.Grupo!).Distinct().OrderBy(g => g).ToList();
        <div class="jornada-grupo-chips">
            <button class="jornada-grupo-chip @(_grupoFiltro == null ? "on" : "")"
                    @onclick="() => _grupoFiltro = null">Todos</button>
            @foreach (var g in gruposJornada)
            {
                var gLocal = g;
                <button class="jornada-grupo-chip @(_grupoFiltro == gLocal ? "on" : "")"
                        @onclick="() => _grupoFiltro = (_grupoFiltro == gLocal ? null : gLocal)">@g</button>
            }
        </div>
    }
    @if (_grupoFiltro != null)
    {
        var clientesGrupoList = Estado.Clientes.Where(c => c.Grupo == _grupoFiltro).ToList();
        var (gBruto, gNeto, gEfect, _, _) = Estado.TotalesFiltrados(clientesGrupoList.Select(c => c.Id));
        <div class="jornada-grupo-banner">
            <span class="material-symbols-rounded" style="font-size:18px;">group</span>
            <span>@_grupoFiltro · @clientesGrupoList.Count cliente@(clientesGrupoList.Count == 1 ? "" : "s")</span>
            <div style="margin-left:auto;display:flex;gap:12px;font-size:12px;flex-wrap:wrap;">
                <span>Bruto: <strong class="tabnum text-em">@gBruto.ToString("C0", _mx)</strong></span>
                <span>Neto: <strong class="tabnum text-vi">@gNeto.ToString("C0", _mx)</strong></span>
                <span>Efectivo: <strong class="tabnum text-in">@gEfect.ToString("C0", _mx)</strong></span>
            </div>
        </div>
    }

    <div class="jornada-client-list">
        @{
            var clientesFiltrados = ClientesFiltrados.ToList();
        }
        @foreach (var cliente in clientesFiltrados)
        {
            var excluido = Estado.Exclusiones.TryGetValue(cliente.Id, out var ex) && ex.ExcluidoDeEfectivo;
            var (cliNeto, _) = Estado.TotalesCliente(cliente.Id);
            var chips = GetChipsCliente(cliente.Id);
            <div class="jornada-client-card @(excluido ? "excluido" : "")"
                 @onclick="() => IrACliente(cliente.Id)">
                <div class="jornada-card-body">
                    <div class="jornada-card-nombre">@cliente.Nombre</div>
                    <div class="jornada-card-chips">
                        @if (chips.Count == 0)
                        {
                            <span class="jornada-card-chip sin-datos">Sin capturar</span>
                        }
                        else
                        {
                            @foreach (var chip in chips)
                            {
                                <span class="jornada-card-chip">@chip</span>
                            }
                        }
                    </div>
                </div>
                <div class="jornada-card-right">
                    <span class="jornada-card-monto">@cliNeto.ToString("C", _mx)</span>
                    @if (excluido && ex != null)
                    {
                        <span class="jornada-card-excl">@GetMetodoPagoLabel(ex.MetodoPagoAlternativo)</span>
                    }
                </div>
                <span class="material-symbols-rounded" style="color:var(--gray-muted);font-size:18px;flex-shrink:0;">chevron_right</span>
            </div>
        }

        @if (Estado.Clientes.Count == 0)
        {
            <div class="empty-state">
                <span class="material-symbols-rounded">group</span>
                <p>No hay clientes con entrega programada para hoy.</p>
            </div>
        }
        else if (clientesFiltrados.Count == 0)
        {
            <div class="empty-state">
                <span class="material-symbols-rounded">search_off</span>
                <p>No se encontraron clientes con ese nombre.</p>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int? JornadaId { get; set; }

    private static readonly System.Globalization.CultureInfo _mx =
        System.Globalization.CultureInfo.GetCultureInfo("es-MX");

    private bool   _cargando        = true;
    private bool   _soloLectura;
    private bool   _puedeAbrir;
    private bool   _initialized;
    private int    _negocioId;
    private string _saveText        = "Guardado ✓";
    private string _saveClass       = "save-ok";
    private string  _busquedaCliente = string.Empty;
    private bool    _mostrarDinero   = true;
    private string? _grupoFiltro;
    private bool    _sincronizando;   // descargando datos desde la nube
    private bool    _sinDatosLocales; // offline y sin caché disponible

    private IEnumerable<CustomerDto> ClientesFiltrados =>
        Estado.Clientes
            .Where(c => string.IsNullOrWhiteSpace(_busquedaCliente) || c.Nombre.Contains(_busquedaCliente, StringComparison.OrdinalIgnoreCase))
            .Where(c => _grupoFiltro == null || c.Grupo == _grupoFiltro);

    private record ProductTotal(string Nombre, decimal Total, bool EsGramaje);

    private List<ProductTotal> GetTotalesProductos()
    {
        var result = new List<ProductTotal>();
        var clientes = _grupoFiltro == null
            ? Estado.Clientes
            : Estado.Clientes.Where(c => c.Grupo == _grupoFiltro).ToList();
        foreach (var prod in Estado.Productos)
        {
            decimal total = 0;
            foreach (var cliente in clientes)
                foreach (var ronda in Estado.Jornada?.Rondas ?? new())
                    total += Estado.GetOrCreate(ronda.Id, cliente.Id, prod.Id).Entregado;
            if (total > 0)
                result.Add(new(prod.Nombre, total, prod.TipoMedida == TipoMedida.Gramaje));
        }
        return result;
    }

    protected override async Task OnInitializedAsync()
    {
        Estado.OnChange += StateHasChanged;
        OfflineSync.OnConnectivityChanged += OnConectividadCambia;
        OfflineSync.OnSynced += OnDatosSincronizados;

        var user = await AuthSvc.GetCurrentUser();
        _negocioId   = user?.NegocioIds.FirstOrDefault() ?? 0;
        _soloLectura = user?.Rol == UserRole.Supervisor;
        _puedeAbrir  = user?.Rol == UserRole.Repartidor;
        _initialized = true;

        await CargarSiNecesario();
        _cargando = false;

        // Si hay ops pendientes, reflejar estado en el indicador
        var pending = await OfflineSync.PendingCountAsync();
        if (pending > 0 && !JornadaId.HasValue)
        {
            _saveText  = $"{pending} cambio(s) pendiente(s)";
            _saveClass = "save-pending";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized) return;
        await CargarSiNecesario();
    }

    private async Task CargarSiNecesario()
    {
        if (JornadaId.HasValue)
        {
            if (Estado.Jornada?.Id != JornadaId.Value)
            {
                Estado.Limpiar();
                _cargando = true;
                StateHasChanged();
                await CargarJornada();
                _cargando = false;
            }
        }
        else if (!Estado.Cargado && _negocioId > 0)
        {
            await CargarJornada();
        }
    }

    private bool _loadedFromCache;

    private async Task CargarJornada()
    {
        _sinDatosLocales = false;

        if (JornadaId.HasValue)
        {
            await CargarDesdeApi();
            return;
        }

        // 1. Intentar local primero (no requiere red → instante)
        bool tieneLocal = await CargarDesdeLocal();

        if (tieneLocal)
        {
            // Datos disponibles al instante; API en segundo plano si hay conexión
            _ = RefrescarDesdeApiAsync();
        }
        else
        {
            // Sin caché → intentar API (primera vez u otro dispositivo)
            await CargarDesdeApi();

            // Si sigue sin jornada y no hay red → indicar "sin datos locales"
            if (!Estado.Cargado)
                _sinDatosLocales = !OfflineSync.IsOnline;
        }
    }

    private async Task<bool> CargarDesdeLocal()
    {
        if (_negocioId == 0) return false;
        try
        {
            var snap = await LocalData.GetSnapshotAsync(_negocioId);
            if (snap?.Jornada?.Id is not > 0) return false;

            // Aceptar si es de hoy O si la jornada sigue abierta (tolerancia a
            // diferencias de zona horaria y reinicios entre días)
            var esDeHoy    = snap.Jornada.Fecha == DateOnly.FromDateTime(DateTime.Today);
            var estaAbierta = snap.Jornada.Estado == JornadaEstado.Abierta;
            if (!esDeHoy && !estaAbierta) return false;

            var clientes = snap.Clientes.Any()
                ? snap.Clientes.Where(TieneEntregaHoy).ToList()
                : new();

            Estado.Cargar(snap.Jornada, snap.Productos, clientes);
            _loadedFromCache = true;
            return true;
        }
        catch { return false; }
    }

    private async Task CargarDesdeApi()
    {
        try
        {
            JornadaDto? jornada;
            if (JornadaId.HasValue)
            {
                jornada = await Api.GetJornadaByIdAsync(JornadaId.Value);
                if (jornada != null) _negocioId = jornada.TenantId;
            }
            else
            {
                jornada = await Api.GetJornadaHoyAsync(_negocioId);
            }

            if (jornada != null)
            {
                var productos = await Api.GetProductosAsync(_negocioId) ?? new();
                var clientes  = (await Api.GetClientesAsync(_negocioId) ?? new())
                                .Where(c => JornadaId.HasValue || TieneEntregaHoy(c)).ToList();

                if (!JornadaId.HasValue)
                    await LocalData.SaveSnapshotAsync(_negocioId, new JornadaSnapshot
                    {
                        Jornada   = jornada,
                        Productos = productos,
                        Clientes  = clientes
                    });

                Estado.Cargar(jornada, productos, clientes);
                _loadedFromCache  = false;
                _sinDatosLocales  = false;
            }
        }
        catch { }
    }

    /// <summary>Descarga datos actualizados en segundo plano y actualiza el snapshot local.</summary>
    private async Task RefrescarDesdeApiAsync()
    {
        if (_negocioId == 0) return;
        try
        {
            var jornada = await Api.GetJornadaHoyAsync(_negocioId);
            if (jornada == null) return;

            var productos = await Api.GetProductosAsync(_negocioId) ?? new();
            var clientes  = (await Api.GetClientesAsync(_negocioId) ?? new())
                            .Where(TieneEntregaHoy).ToList();

            // Siempre actualizar snapshot local con datos frescos del servidor
            await LocalData.SaveSnapshotAsync(_negocioId, new JornadaSnapshot
            {
                Jornada   = jornada,
                Productos = productos,
                Clientes  = clientes
            });

            // Solo sobreescribir estado en memoria si no hay ediciones locales pendientes
            var pending = await LocalData.CountPendingAsync();
            if (pending == 0)
            {
                Estado.Cargar(jornada, productos, clientes);
                _loadedFromCache = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    /// <summary>Descarga TODOS los datos desde la nube y los persiste en local. Botón manual.</summary>
    private async Task SincronizarDatosAsync()
    {
        if (_negocioId == 0 || _sincronizando) return;
        _sincronizando   = true;
        _sinDatosLocales = false;
        StateHasChanged();
        try
        {
            var jornada   = await Api.GetJornadaHoyAsync(_negocioId);
            var productos  = await Api.GetProductosAsync(_negocioId) ?? new();
            var clientesTodos = await Api.GetClientesAsync(_negocioId) ?? new();
            var clientes   = clientesTodos.Where(TieneEntregaHoy).ToList();

            if (jornada != null)
            {
                await LocalData.SaveSnapshotAsync(_negocioId, new JornadaSnapshot
                {
                    Jornada   = jornada,
                    Productos = productos,
                    Clientes  = clientesTodos   // guardar TODOS para offline
                });

                // Sincronizar ops pendientes primero, luego aplicar estado del servidor
                await OfflineSync.ProcessQueueAsync();
                Estado.Cargar(jornada, productos, clientes);
                _loadedFromCache = false;
                Snackbar.Add("Datos sincronizados ✓", Severity.Success);
            }
            else
            {
                Snackbar.Add("No hay jornada activa hoy", Severity.Info);
            }
        }
        catch
        {
            Snackbar.Add("Error de conexión al sincronizar", Severity.Error);
        }
        finally
        {
            _sincronizando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool TieneEntregaHoy(CustomerDto c)
    {
        var hoy = (int)DateTime.Today.DayOfWeek;
        int bit = hoy == 0 ? 64 : (1 << (hoy - 1));
        return (c.DiasEntrega & bit) != 0 || c.DiasEntrega == 0;
    }

    private void IrACliente(int clienteId)
        => Nav.NavigateTo($"/repartidor/jornada/cliente/{clienteId}");

    private List<string> GetChipsCliente(int clienteId)
    {
        var chips = new List<string>();
        foreach (var prod in Estado.Productos)
        {
            decimal totalEnt = 0;
            foreach (var ronda in Estado.Jornada?.Rondas ?? new())
                totalEnt += Estado.GetOrCreate(ronda.Id, clienteId, prod.Id).Entregado;
            if (totalEnt > 0)
            {
                var lbl = prod.TipoMedida == TipoMedida.Gramaje
                    ? $"{totalEnt:0.##} kg {prod.Nombre}"
                    : $"{totalEnt:0.##} {prod.Nombre}";
                chips.Add(lbl);
            }
        }
        return chips;
    }

    private async Task AgregarRonda()
    {
        var dialog = await Dialog.ShowAsync<AgregarRondaDialog>("Nueva Vuelta");
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is string etiqueta)
        {
            var resp = await Api.AddRondaAsync(Estado.Jornada!.Id, new AddRondaRequest { Etiqueta = etiqueta });
            if (resp.IsSuccessStatusCode)
            {
                var nueva = await resp.Content.ReadFromJsonAsync<RondaDto>();
                if (nueva != null) { Estado.Jornada!.Rondas.Add(nueva); Estado.Notificar(); }
                Snackbar.Add("Vuelta agregada", Severity.Success);
            }
        }
    }

    private async Task CerrarJornada()
    {
        if (!OfflineSync.IsOnline)
        {
            Snackbar.Add("Necesitas conexión para cerrar la jornada", Severity.Warning);
            return;
        }
        var (_, _, efect, _, _) = Estado.Totales();
        var confirm = await Dialog.ShowMessageBox("Cerrar jornada",
            $"Efectivo a rendir: {efect.ToString("C", _mx)}. ¿Confirmar cierre?",
            yesText: "Confirmar cierre", cancelText: "Cancelar");
        if (confirm != true) return;
        try
        {
            var resp = await Api.CerrarJornadaAsync(Estado.Jornada!.Id);
            if (resp.IsSuccessStatusCode)
            {
                Estado.Jornada.Estado = JornadaEstado.Cerrada;
                Estado.Notificar();
                // Actualizar snapshot local con el nuevo estado
                await LocalData.SaveSnapshotAsync(_negocioId, new JornadaSnapshot
                {
                    Jornada   = Estado.GetSnapshotJornada(),
                    Productos = Estado.Productos,
                    Clientes  = Estado.Clientes
                });
                Snackbar.Add($"Jornada cerrada. Efectivo: {efect.ToString("C", _mx)}", Severity.Success);
            }
        }
        catch { Snackbar.Add("Error de conexión al cerrar jornada", Severity.Error); }
    }

    private async Task AbrirJornada()
    {
        if (!OfflineSync.IsOnline)
        {
            Snackbar.Add("Necesitas conexión para abrir una jornada", Severity.Warning);
            return;
        }
        try
        {
            var resp = await Api.AbrirJornadaAsync(new OpenJornadaRequest { TenantId = _negocioId });
            if (resp.IsSuccessStatusCode)
            {
                Estado.Limpiar();
                _loadedFromCache = false;
                await CargarJornada();
            }
            else
            {
                Snackbar.Add("No se pudo abrir la jornada", Severity.Error);
            }
        }
        catch { Snackbar.Add("Error de conexión al abrir jornada", Severity.Error); }
    }

    private static string GetMetodoPagoLabel(MetodoPago mp) => mp switch
    {
        MetodoPago.TarjetaCredito => "T. CRÉDITO",
        MetodoPago.TarjetaDebito  => "T. DÉBITO",
        MetodoPago.Transferencia  => "TRANSF.",
        _                         => "OTRO"
    };

    private void OnConectividadCambia()
    {
        if (!JornadaId.HasValue)
        {
            if (OfflineSync.IsOnline)
            {
                // Si estábamos en modo "sin datos", intentar cargar ahora que hay red
                if (_sinDatosLocales || !Estado.Cargado)
                    InvokeAsync(async () => { await CargarJornada(); StateHasChanged(); });
                else
                    _ = RefrescarDesdeApiAsync();
            }
            else
            {
                // Se perdió la conexión — actualizar indicadores en la UI
                InvokeAsync(StateHasChanged);
            }
        }
    }

    private async void OnDatosSincronizados()
    {
        // La cola se vació → ahora sí podemos tomar el estado del servidor
        _saveText  = "Sincronizado ✓";
        _saveClass = "save-ok";
        if (!JornadaId.HasValue)
            _ = RefrescarDesdeApiAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Estado.OnChange -= StateHasChanged;
        OfflineSync.OnConnectivityChanged -= OnConectividadCambia;
        OfflineSync.OnSynced -= OnDatosSincronizados;
    }
}
