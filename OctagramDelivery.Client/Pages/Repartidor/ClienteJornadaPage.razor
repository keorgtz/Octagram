@page "/repartidor/jornada/cliente/{ClienteId:int}"
@page "/jornada/{JornadaId:int}/cliente/{ClienteId:int}"
@attribute [Authorize(Roles = $"{nameof(UserRole.Repartidor)},{nameof(UserRole.Gerente)},{nameof(UserRole.Supervisor)},{nameof(UserRole.Admin)}")]
@implements IAsyncDisposable
@inject ApiService Api
@inject AuthService AuthSvc
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Nav
@inject JornadaStateService Estado
@inject OfflineSyncService OfflineSync
@inject LocalDataService LocalData
@inject HubService Hub

<PageTitle>Cliente · TortiCloud</PageTitle>

@if (_cargando)
{
    <div style="display:flex;height:60vh;align-items:center;justify-content:center;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (_cliente == null)
{
    <div class="empty-state">
        <span class="material-symbols-rounded">person_off</span>
        <p>Cliente no encontrado.</p>
        <MudButton Variant="Variant.Text" OnClick="Regresar">Regresar</MudButton>
    </div>
}
else
{
    <!-- Header sticky -->
    <div class="cj-header">
        <button class="icon-btn" @onclick="Regresar">
            <span class="material-symbols-rounded">arrow_back</span>
        </button>
        <span class="cj-header-title">@_cliente.Nombre</span>
        @if (_soloLectura)
        {
            <span class="badge-solo-lectura">
                <span class="material-symbols-rounded" style="font-size:13px;">visibility</span>
                Solo lectura
            </span>
        }
        else
        {
            <button class="icon-btn @(_guardandoManual ? "syncing" : "")"
                    title="Guardar cambios"
                    @onclick="GuardarManualAsync"
                    disabled="@_guardandoManual">
                <span class="material-symbols-rounded">@(_guardandoManual ? "sync" : "save")</span>
            </button>
            <span class="save-indicator @_saveClass" style="font-size:11px;">@_saveText</span>
        }
    </div>

    <!-- Vuelta tabs -->
    <div class="cj-vuelta-bar">
        @foreach (var ronda in Estado.Jornada?.Rondas ?? new())
        {
            <button class="cj-vuelta-tab @(_rondaActivaId == ronda.Id ? "active" : "")"
                    @onclick="() => _rondaActivaId = ronda.Id">
                @ronda.Etiqueta
            </button>
        }
        @if (!_soloLectura && Estado.Jornada?.Estado == JornadaEstado.Abierta)
        {
            <button class="cj-vuelta-tab add" @onclick="AgregarRonda">
                <span class="material-symbols-rounded" style="font-size:16px;">add</span>
            </button>
        }
    </div>

    <!-- Productos -->
    <div class="cj-productos">
        @{
            var grupos = GetGruposDisplay();
            var usaGrupos = _gruposProducto.Count > 0;
            var noEditar = _soloLectura || Estado.Jornada?.Estado != JornadaEstado.Abierta;
        }

        @if (usaGrupos && grupos.Count > 0)
        {
            @foreach (var grupo in grupos)
            {
                var expandido = grupo.Id == null ? _sinGrupoExpandido : _grupoExpandidoId == grupo.Id;
                var icono = grupo.Id == null ? "label_off" : "category";
                <div class="cj-grupo-acordion">
                    <button class="cj-grupo-header @(expandido ? "abierto" : "")"
                            @onclick="() => ToggleGrupo(grupo.Id)">
                        <span class="material-symbols-rounded" style="font-size:20px;color:var(--vi,#8B5CF6);flex-shrink:0;">@icono</span>
                        <span class="cj-grupo-nombre">@grupo.Nombre</span>
                        <span class="cj-grupo-count">@grupo.Productos.Count</span>
                        <span class="material-symbols-rounded cj-grupo-chevron">expand_more</span>
                    </button>
                    @if (expandido)
                    {
                        @foreach (var prod in grupo.Productos)
                        {
                            var celda    = Estado.GetOrCreate(_rondaActivaId, ClienteId, prod.ProductId);
                            var subtotal = (celda.Entregado - celda.Devuelto) * celda.Precio;
                            var titEnt   = "Entregado — " + prod.ProductNombre;
                            var titDev   = "Devuelto — "  + prod.ProductNombre;
                            var tipo     = prod.TipoMedida;
                            <div class="cj-producto-card cj-producto-en-grupo">
                                <div class="cj-producto-header">
                                    <span class="cj-producto-nombre">@prod.ProductNombre</span>
                                    <span class="cj-producto-subtotal">@subtotal.ToString("C", _mx)</span>
                                </div>
                                <div class="cj-qty-row">
                                    <span class="cj-qty-label entregado">Entregado</span>
                                    <div style="display:flex;align-items:center;gap:8px;">
                                        <span class="cj-qty-display">@FormatQty(celda.Entregado, tipo)</span>
                                        @if (!_soloLectura)
                                        {
                                            <button class="cj-qty-btn" disabled="@noEditar"
                                                    @onclick="() => AbrirNumpad(celda, true, tipo, titEnt)">
                                                <span class="material-symbols-rounded">edit</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="cj-qty-row">
                                    <span class="cj-qty-label devuelto">Devuelto</span>
                                    <div style="display:flex;align-items:center;gap:8px;">
                                        <span class="cj-qty-display">@FormatQty(celda.Devuelto, tipo)</span>
                                        @if (!_soloLectura)
                                        {
                                            <button class="cj-qty-btn" disabled="@noEditar"
                                                    @onclick="() => AbrirNumpad(celda, false, tipo, titDev)">
                                                <span class="material-symbols-rounded">edit</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        }
        else
        {
            @foreach (var prod in _productosDelCliente.OrderBy(p => p.ProductId))
            {
                var celda    = Estado.GetOrCreate(_rondaActivaId, ClienteId, prod.ProductId);
                var subtotal = (celda.Entregado - celda.Devuelto) * celda.Precio;
                var titEnt   = "Entregado — " + prod.ProductNombre;
                var titDev   = "Devuelto — "  + prod.ProductNombre;
                var tipo     = prod.TipoMedida;
                <div class="cj-producto-card">
                    <div class="cj-producto-header">
                        <span class="cj-producto-nombre">@prod.ProductNombre</span>
                        <span class="cj-producto-subtotal">@subtotal.ToString("C", _mx)</span>
                    </div>
                    <div class="cj-qty-row">
                        <span class="cj-qty-label entregado">Entregado</span>
                        <div style="display:flex;align-items:center;gap:8px;">
                            <span class="cj-qty-display">@FormatQty(celda.Entregado, tipo)</span>
                            @if (!_soloLectura)
                            {
                                <button class="cj-qty-btn" disabled="@noEditar"
                                        @onclick="() => AbrirNumpad(celda, true, tipo, titEnt)">
                                    <span class="material-symbols-rounded">edit</span>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="cj-qty-row">
                        <span class="cj-qty-label devuelto">Devuelto</span>
                        <div style="display:flex;align-items:center;gap:8px;">
                            <span class="cj-qty-display">@FormatQty(celda.Devuelto, tipo)</span>
                            @if (!_soloLectura)
                            {
                                <button class="cj-qty-btn" disabled="@noEditar"
                                        @onclick="() => AbrirNumpad(celda, false, tipo, titDev)">
                                    <span class="material-symbols-rounded">edit</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        @if (_productosDelCliente.Count == 0)
        {
            <div class="empty-state">
                <span class="material-symbols-rounded">inventory_2</span>
                <p>Este cliente no tiene productos asignados.</p>
            </div>
        }
    </div>

    <!-- Footer -->
    <div class="cj-footer">
        <div class="cj-footer-total">
            <span class="cj-footer-label">Total a cobrar</span>
            <span class="cj-footer-amount">@GetTotalCliente().ToString("C", _mx)</span>
        </div>
        <MudToggleIconButton Toggled="_excluido"
                             ToggledChanged="ToggleExclusion"
                             Icon="@Icons.Material.Rounded.AttachMoney"
                             ToggledIcon="@Icons.Material.Rounded.MoneyOff"
                             Color="Color.Success"
                             ToggledColor="Color.Warning"
                             Disabled="@(_soloLectura || Estado.Jornada?.Estado != JornadaEstado.Abierta)" />
    </div>
}

<!-- Numpad flotante -->
<NumpadDialog @bind-Visible="_numpadVisible"
              Titulo="@_numpadTitulo"
              ValorInicial="@_numpadValorInicial"
              PermiteDecimal="@_numpadDecimal"
              OnConfirmar="OnNumpadConfirmar" />

@code {
    [Parameter] public int  ClienteId  { get; set; }
    [Parameter] public int? JornadaId  { get; set; }

    private static readonly System.Globalization.CultureInfo _mx =
        System.Globalization.CultureInfo.GetCultureInfo("es-MX");

    private bool         _cargando = true;
    private bool         _soloLectura;
    private CustomerDto? _cliente;
    private List<CustomerProductDto> _productosDelCliente = new();
    private int          _rondaActivaId;
    private bool         _excluido;

    // Grupos de producto
    private List<GrupoProductoDto> _gruposProducto = new();
    private int?  _grupoExpandidoId;   // Id del grupo expandido (null = ninguno)
    private bool  _sinGrupoExpandido;  // "Sin grupo" está expandido

    private string _saveText  = "Guardado ✓";
    private string _saveClass = "save-ok";
    private bool   _guardandoManual;

    // Numpad state
    private bool             _numpadVisible;
    private string           _numpadTitulo = "";
    private decimal?         _numpadValorInicial;
    private bool             _numpadDecimal;
    private JornadaStateService.CeldaState? _numpadCelda;
    private bool             _numpadEsEntregado;

    private bool _enVivo;
    private List<IDisposable> _hubSubs = new();

    protected override async Task OnInitializedAsync()
    {
        Estado.OnChange += StateHasChanged;

        var currentUser = await AuthSvc.GetCurrentUser();
        // Supervisor → siempre solo lectura; Gerente en modo monitor (JornadaId) → solo lectura
        // Admin nunca es solo lectura
        _soloLectura = currentUser?.Rol == UserRole.Supervisor
                    || (JornadaId.HasValue && currentUser?.Rol != UserRole.Repartidor && currentUser?.Rol != UserRole.Admin);

        // Gate de permiso: Supervisor sin VerHojaReparto no puede acceder
        if (currentUser?.Rol == UserRole.Supervisor)
        {
            var negocioId = Estado.Jornada?.TenantId ?? 0;
            if (negocioId > 0 && !currentUser.PuedeVerHojaReparto(negocioId))
            {
                Nav.NavigateTo("/");
                return;
            }
        }

        if (!Estado.Cargado)
        {
            // Estado no disponible: redirigir a la vista correcta para que recargue
            Nav.NavigateTo(JornadaId.HasValue ? $"/gerente/jornada/{JornadaId}" : "/repartidor/jornada");
            return;
        }

        _cliente = Estado.Clientes.FirstOrDefault(c => c.Id == ClienteId);
        _productosDelCliente = _cliente?.Productos ?? new();
        _rondaActivaId = Estado.Jornada?.Rondas.FirstOrDefault()?.Id ?? 0;
        _excluido = Estado.Exclusiones.TryGetValue(ClienteId, out var ex) && ex.ExcluidoDeEfectivo;

        // Cargar grupos de producto desde snapshot local, ordenados por Id
        if (Estado.Jornada?.TenantId is > 0)
        {
            var negSnap = await LocalData.GetNegocioSnapshotAsync(Estado.Jornada.TenantId);
            _gruposProducto = negSnap?.GruposProducto.OrderBy(g => g.Id).ToList() ?? new();
        }
        // Auto-expandir el primer grupo
        _grupoExpandidoId = _gruposProducto.FirstOrDefault()?.Id;

        _cargando = false;

        // Connect to SignalR for real-time sync
        _ = ConectarHubAsync();
    }

    private void AbrirNumpad(JornadaStateService.CeldaState celda, bool esEntregado,
                              TipoMedida tipo, string titulo)
    {
        _numpadCelda       = celda;
        _numpadEsEntregado = esEntregado;
        _numpadTitulo      = titulo;
        _numpadValorInicial = esEntregado ? celda.Entregado : celda.Devuelto;
        _numpadDecimal     = tipo == TipoMedida.Gramaje;
        _numpadVisible     = true;
    }

    private async Task OnNumpadConfirmar(decimal valor)
    {
        if (_numpadCelda == null || _soloLectura) return;
        if (_numpadEsEntregado) _numpadCelda.Entregado = valor;
        else                    _numpadCelda.Devuelto  = Math.Min(valor, _numpadCelda.Entregado);
        Estado.HayCambiosPendientes = true;
        Estado.Notificar();
        await GuardarCambiosApiAsync();
    }

    private async Task GuardarCambiosApiAsync()
    {
        if (Estado.Jornada == null || !OfflineSync.IsOnline) return;
        _saveText = "Guardando…";
        _saveClass = "save-pending";
        await InvokeAsync(StateHasChanged);

        try
        {
            foreach (var ronda in Estado.Jornada.Rondas)
            {
                var detalles = _productosDelCliente.Select(p =>
                {
                    var c = Estado.GetOrCreate(ronda.Id, ClienteId, p.ProductId);
                    return new DetalleUpsertItem
                    {
                        ClienteId = ClienteId,
                        ProductoId = p.ProductId,
                        CantidadEntregada = c.Entregado,
                        CantidadDevuelta = c.Devuelto,
                        PrecioUnitario = c.Precio,
                        GramajePreset = c.GramajePreset
                    };
                }).ToList();
                await Api.BulkSaveDetallesAsync(ronda.Id, new BulkSaveRondaRequest { Detalles = detalles });
            }
            _saveText = "Guardado ✓";
            _saveClass = "save-ok";
            Estado.HayCambiosPendientes = false;
        }
        catch
        {
            _saveText = "Error al guardar";
            _saveClass = "save-error";
        }
        await InvokeAsync(StateHasChanged);
    }

    // ── Grupos accordion ────────────────────────────────────────────────────
    private record GrupoDisplay(int? Id, string Nombre, List<CustomerProductDto> Productos);

    private List<GrupoDisplay> GetGruposDisplay()
    {
        // Mapa productoId → grupoProductoId (desde Estado.Productos que tiene GrupoProductoId)
        var grupoMap = Estado.Productos.ToDictionary(p => p.Id, p => p.GrupoProductoId);
        var asignados = new HashSet<int>();
        var result = new List<GrupoDisplay>();

        foreach (var grupo in _gruposProducto.OrderBy(g => g.Id))
        {
            var prods = _productosDelCliente
                .Where(p => grupoMap.TryGetValue(p.ProductId, out var gid) && gid == grupo.Id)
                .OrderBy(p => p.ProductId)
                .ToList();
            if (prods.Count == 0) continue;
            foreach (var p in prods) asignados.Add(p.ProductId);
            result.Add(new(grupo.Id, grupo.Nombre, prods));
        }

        // Productos sin grupo al final, ordenados por Id
        var sinGrupo = _productosDelCliente
            .Where(p => !asignados.Contains(p.ProductId))
            .OrderBy(p => p.ProductId)
            .ToList();
        if (sinGrupo.Count > 0)
            result.Add(new(null, "Sin grupo", sinGrupo));

        return result;
    }

    private void ToggleGrupo(int? grupoId)
    {
        if (grupoId == null)
            _sinGrupoExpandido = !_sinGrupoExpandido;
        else
            _grupoExpandidoId = _grupoExpandidoId == grupoId ? null : grupoId;
    }

    private async Task GuardarManualAsync()
    {
        if (_guardandoManual || Estado.Jornada == null) return;
        _guardandoManual = true;
        _saveText = "Guardando…";
        _saveClass = "save-pending";
        await InvokeAsync(StateHasChanged);

        try
        {
            // Save all changes to API
            foreach (var ronda in Estado.Jornada.Rondas)
            {
                var detalles = _productosDelCliente.Select(p =>
                {
                    var c = Estado.GetOrCreate(ronda.Id, ClienteId, p.ProductId);
                    return new DetalleUpsertItem
                    {
                        ClienteId = ClienteId,
                        ProductoId = p.ProductId,
                        CantidadEntregada = c.Entregado,
                        CantidadDevuelta = c.Devuelto,
                        PrecioUnitario = c.Precio,
                        GramajePreset = c.GramajePreset
                    };
                }).ToList();
                await Api.BulkSaveDetallesAsync(ronda.Id, new BulkSaveRondaRequest { Detalles = detalles });
            }

            // Refresh from server
            if (OfflineSync.IsOnline && Estado.Jornada != null)
            {
                var jornada = await Api.GetJornadaByIdAsync(Estado.Jornada.Id);
                if (jornada != null)
                {
                    Estado.Cargar(jornada, Estado.Productos, Estado.Clientes);
                    _excluido = Estado.Exclusiones.TryGetValue(ClienteId, out var ex) && ex.ExcluidoDeEfectivo;
                }
            }

            _saveText = "Sincronizado ✓";
            _saveClass = "save-ok";
            Estado.HayCambiosPendientes = false;
            Snackbar.Add(OfflineSync.IsOnline ? "Cambios guardados y sincronizados" : "Sin conexión",
                OfflineSync.IsOnline ? Severity.Success : Severity.Warning);
        }
        catch
        {
            _saveText = "Error al guardar";
            _saveClass = "save-error";
            Snackbar.Add("Error al guardar los cambios", Severity.Error);
        }
        finally
        {
            _guardandoManual = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleExclusion(bool excluido)
    {
        if (Estado.Jornada == null || !OfflineSync.IsOnline) return;
        _excluido = excluido;
        var metodo = excluido ? MetodoPago.Transferencia : MetodoPago.Efectivo;
        if (Estado.Exclusiones.TryGetValue(ClienteId, out var ex))
        {
            ex.ExcluidoDeEfectivo = excluido;
            ex.MetodoPagoAlternativo = metodo;
        }
        else
        {
            Estado.Exclusiones[ClienteId] = new ClienteJornadaDto
            {
                ClienteId = ClienteId,
                ExcluidoDeEfectivo = excluido,
                MetodoPagoAlternativo = metodo
            };
        }
        Estado.Notificar();

        try
        {
            await Api.ToggleExclusionAsync(Estado.Jornada.Id, ClienteId, new ToggleExclusionRequest
            {
                ExcluidoDeEfectivo = excluido,
                MetodoPagoAlternativo = metodo
            });
        }
        catch
        {
            Snackbar.Add("Error al guardar la exclusión", Severity.Error);
        }
    }

    private async Task AgregarRonda()
    {
        var dialog = await Dialog.ShowAsync<AgregarRondaDialog>("Nueva Vuelta");
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is string etiqueta)
        {
            var resp = await Api.AddRondaAsync(Estado.Jornada!.Id, new AddRondaRequest { Etiqueta = etiqueta });
            if (resp.IsSuccessStatusCode)
            {
                var nueva = await resp.Content.ReadFromJsonAsync<RondaDto>();
                if (nueva != null)
                {
                    Estado.Jornada!.Rondas.Add(nueva);
                    _rondaActivaId = nueva.Id;
                    Estado.Notificar();
                }
                Snackbar.Add("Vuelta agregada", Severity.Success);
            }
        }
    }

    private decimal GetTotalCliente()
    {
        var (neto, _) = Estado.TotalesCliente(ClienteId);
        return neto;
    }

    private static string FormatQty(decimal qty, TipoMedida tipo)
        => tipo == TipoMedida.Gramaje ? qty.ToString("0.##") : ((int)qty).ToString();

    private void Regresar()
        => Nav.NavigateTo(JornadaId.HasValue ? $"/gerente/jornada/{JornadaId}" : "/repartidor/jornada");

    private async Task ConectarHubAsync()
    {
        try
        {
            await Hub.ConnectAsync();
            if (Estado.Jornada?.TenantId is > 0)
                await Hub.JoinNegocioAsync(Estado.Jornada.TenantId);
            _hubSubs.Add(Hub.On<object>("JornadaActualizada", async _ =>
            {
                await InvokeAsync(async () =>
                {
                    // Refresh delivery data from server when another device makes changes
                    if (OfflineSync.IsOnline && Estado.Jornada != null)
                    {
                        var jornada = await Api.GetJornadaByIdAsync(Estado.Jornada.Id);
                        if (jornada != null)
                        {
                            var productos = Estado.Productos;
                            var clientes = Estado.Clientes;
                            Estado.Cargar(jornada, productos, clientes);
                            _excluido = Estado.Exclusiones.TryGetValue(ClienteId, out var ex) && ex.ExcluidoDeEfectivo;
                            StateHasChanged();
                        }
                    }
                });
            }));
            _enVivo = true;
        }
        catch { /* funciona sin SignalR */ }
    }

    public async ValueTask DisposeAsync()
    {
        Estado.OnChange -= StateHasChanged;
        foreach (var s in _hubSubs) s.Dispose();
        await Hub.DisposeAsync();
    }
}
