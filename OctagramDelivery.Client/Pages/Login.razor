@page "/login"
@layout EmptyLayout
@inject AuthService AuthSvc
@inject NavigationManager Nav

<PageTitle>Iniciar sesión · OctagramDelivery</PageTitle>

<MudThemeProvider />
<MudPopoverProvider />
<MudSnackbarProvider />

<div class="empty-layout">
    <div class="login-card">
        <div class="login-header">
            <span class="material-symbols-rounded fill login-icon">local_shipping</span>
            <div>
                <div class="login-title">Octagram</div>
                <div class="login-subtitle">Delivery · Sistema de Repartos</div>
            </div>
        </div>

        <EditForm Model="_req" OnValidSubmit="DoLogin">
            <MudTextField @bind-Value="_req.Username"
                          Label="Usuario"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Rounded.Person"
                          Disabled="_loading"
                          FullWidth="true"
                          Class="mb-3" />

            <MudTextField @bind-Value="_req.Password"
                          Label="Contraseña"
                          Variant="Variant.Outlined"
                          InputType="@(_showPass ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPass ? Icons.Material.Rounded.VisibilityOff : Icons.Material.Rounded.Visibility)"
                          OnAdornmentClick="() => _showPass = !_showPass"
                          Disabled="_loading"
                          FullWidth="true"
                          Class="mb-4" />

            @if (_error != null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@_error</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="_loading"
                       Style="height:44px;font-weight:600;font-size:15px;border-radius:10px;">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                }
                else
                {
                    <span>Entrar</span>
                }
            </MudButton>
        </EditForm>

        <div style="text-align:center;margin-top:20px;font-size:11px;color:var(--gray-muted,#6B7280);">
            OctagramDelivery · KeorSoft © 2026
        </div>
    </div>
</div>

@code {
    private readonly LoginRequest _req = new();
    private string? _error;
    private bool _loading;
    private bool _showPass;

    private async Task DoLogin()
    {
        _loading = true;
        _error = null;
        var (ok, err) = await AuthSvc.Login(_req);
        if (ok)
        {
            var user = await AuthSvc.GetCurrentUser();
            Nav.NavigateTo(user?.Rol switch
            {
                UserRole.Repartidor => "/repartidor/jornada",
                UserRole.Supervisor => "/supervisor/dashboard",
                UserRole.Gerente    => "/gerente/dashboard",
                UserRole.Admin      => "/admin/dashboard",
                _                   => "/"
            });
        }
        else
        {
            _error = err;
            _loading = false;
        }
    }
}
