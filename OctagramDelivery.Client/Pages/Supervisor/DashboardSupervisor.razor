@page "/supervisor/dashboard"
@attribute [Authorize(Roles = $"{nameof(UserRole.Supervisor)},{nameof(UserRole.Gerente)},{nameof(UserRole.Admin)}")]
@implements IAsyncDisposable
@inject ApiService Api
@inject AuthService AuthSvc
@inject HubService Hub

<PageTitle>Dashboard · TortiCloud</PageTitle>

<div class="page-content">

    <div class="page-header">
        <div>
            <h1 class="h-page-title">Dashboard</h1>
            <p class="page-subtitle">@(_data?.TenantNombre ?? "Cargando...")</p>
        </div>
        <div class="page-header-actions">
            @if (_enVivo)
            {
                <div style="display:flex;align-items:center;gap:6px;font-size:11px;font-weight:600;
                            color:var(--em);padding:4px 10px;background:var(--em-bg,#F0FDF4);
                            border-radius:20px;">
                    <span style="width:7px;height:7px;border-radius:50%;background:var(--em);
                                 display:inline-block;animation:pulse 2s infinite;"></span>
                    En vivo
                </div>
            }
            <MudDatePicker Date="_fecha" DateChanged="OnFechaChanged"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Style="max-width:160px;" />
            <MudIconButton Icon="@Icons.Material.Rounded.Refresh"
                           Color="Color.Primary" title="Actualizar"
                           OnClick="Cargar" />
        </div>
    </div>

    @if (_cargando)
    {
        <div class="loading-state">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (_data == null)
    {
        <div class="empty-state">
            <span class="material-symbols-rounded">inventory_2</span>
            <p>No hay datos para la fecha seleccionada.</p>
        </div>
    }
    else
    {
        <div class="kpi-grid">
            <div class="kpi-card" style="--accent-color:var(--em);">
                <div class="kpi-label">Activos</div>
                <div class="kpi-value">@_data.RepartidoresActivos</div>
            </div>
            <div class="kpi-card" style="--accent-color:var(--am);">
                <div class="kpi-label">Cerrados</div>
                <div class="kpi-value">@_data.RepartidoresCerrados</div>
            </div>
            <div class="kpi-card" style="--accent-color:var(--vi);">
                <div class="kpi-label">Venta Neta</div>
                <div class="kpi-value" style="font-size:22px;">@_data.TotalNeto.ToString("C0", _mx)</div>
            </div>
            <div class="kpi-card" style="--accent-color:var(--in);">
                <div class="kpi-label">Efectivo en Calle</div>
                <div class="kpi-value" style="font-size:22px;">@_data.TotalEfectivoEnCalle.ToString("C0", _mx)</div>
            </div>
        </div>

        <div class="data-card">
            <MudTable Items="_data.Repartidores" Hover="true" Dense="true" Striped="false">
                <HeaderContent>
                    <MudTh>Repartidor</MudTh>
                    <MudTh Style="text-align:center;">Estado</MudTh>
                    <MudTh Style="text-align:center;">Clientes</MudTh>
                    <MudTh Style="text-align:right;">Entregado</MudTh>
                    <MudTh Style="text-align:right;">Devuelto</MudTh>
                    <MudTh Style="text-align:right;">Neto</MudTh>
                    <MudTh Style="text-align:right;">Efectivo</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><span class="fw-500">@context.FullName</span></MudTd>
                    <MudTd Style="text-align:center;">
                        <MudChip T="string"
                                 Color="@(context.Estado == JornadaEstado.Abierta ? Color.Success : Color.Default)"
                                 Size="Size.Small" Variant="Variant.Filled">
                            @(context.Estado == JornadaEstado.Abierta ? "Activo" : "Cerrado")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align:center;color:var(--gray-muted);">
                        @context.ClientesAtendidos<span style="opacity:.5;">/</span>@context.TotalClientes
                    </MudTd>
                    <MudTd Style="text-align:right;" Class="tabnum text-em">
                        @context.TotalEntregado.ToString("C0", _mx)
                    </MudTd>
                    <MudTd Style="text-align:right;" Class="tabnum text-or">
                        @context.TotalDevuelto.ToString("C0", _mx)
                    </MudTd>
                    <MudTd Style="text-align:right;" Class="tabnum text-vi fw-600">
                        @context.TotalNeto.ToString("C0", _mx)
                    </MudTd>
                    <MudTd Style="text-align:right;" Class="tabnum text-in fw-700">
                        @context.TotalEfectivo.ToString("C0", _mx)
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="empty-state">
                        <span class="material-symbols-rounded">person_off</span>
                        <p>No hay repartidores para esta fecha.</p>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </div>
    }

</div>

@code {
    private static readonly System.Globalization.CultureInfo _mx = new("es-MX");

    private DashboardNegocioDto? _data;
    private bool      _cargando  = true;
    private DateTime? _fecha     = DateTime.Today;
    private int       _negocioId;
    private bool      _enVivo;
    private IDisposable? _hubSub;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthSvc.GetCurrentUser();
        _negocioId = user?.NegocioIds.FirstOrDefault() ?? 0;
        await Cargar();
        await ConectarHub();
    }

    private async Task OnFechaChanged(DateTime? f) { _fecha = f; await Cargar(); }

    private async Task Cargar()
    {
        _cargando = true;
        var f = _fecha.HasValue ? DateOnly.FromDateTime(_fecha.Value) : DateOnly.FromDateTime(DateTime.Today);
        _data = await Api.GetDashboardSupervisorAsync(_negocioId, f);
        _cargando = false;
    }

    private async Task ConectarHub()
    {
        try
        {
            await Hub.ConnectAsync();
            await Hub.JoinNegocioAsync(_negocioId);
            _hubSub = Hub.On<object>("JornadaActualizada", async _ =>
            {
                await InvokeAsync(async () => { await Cargar(); StateHasChanged(); });
            });
            _enVivo = true;
            StateHasChanged();
        }
        catch { /* SignalR no disponible, funciona sin él */ }
    }

    public async ValueTask DisposeAsync()
    {
        _hubSub?.Dispose();
        await Hub.DisposeAsync();
    }
}
