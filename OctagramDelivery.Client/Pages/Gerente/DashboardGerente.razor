@page "/gerente/dashboard"
@attribute [Authorize(Roles = $"{nameof(UserRole.Gerente)},{nameof(UserRole.Admin)}")]
@inject ApiService Api

<PageTitle>Dashboard Gerente · OctagramDelivery</PageTitle>

<div class="page-content">

    <div class="page-header">
        <div>
            <h1 class="h-page-title">Vista General</h1>
            <p class="page-subtitle">Resumen de operaciones por fecha</p>
        </div>
        <div class="page-header-actions">
            <MudDatePicker Date="_fecha" DateChanged="OnFechaChanged"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Style="max-width:160px;" />
            <MudIconButton Icon="@Icons.Material.Rounded.Refresh"
                           Color="Color.Primary" title="Actualizar"
                           OnClick="Cargar" />
        </div>
    </div>

    @if (_cargando)
    {
        <div class="loading-state"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
    }
    else
    {
        <div class="kpi-grid">
            <div class="kpi-card" style="--accent-color:var(--primary);">
                <div class="kpi-label">Negocios</div>
                <div class="kpi-value">@_negocios.Count</div>
            </div>
            <div class="kpi-card" style="--accent-color:var(--em);">
                <div class="kpi-label">Repartidores Activos</div>
                <div class="kpi-value">@_negocios.Sum(n => n.RepartidoresActivos)</div>
            </div>
            <div class="kpi-card" style="--accent-color:var(--vi);">
                <div class="kpi-label">Neto Total</div>
                <div class="kpi-value" style="font-size:22px;">@_negocios.Sum(n => n.TotalNeto).ToString("C0", _mx)</div>
            </div>
            <div class="kpi-card" style="--accent-color:var(--primary);">
                <div class="kpi-label">Efectivo Total</div>
                <div class="kpi-value" style="font-size:22px;">@_negocios.Sum(n => n.TotalEfectivoEnCalle).ToString("C0", _mx)</div>
            </div>
        </div>

        @if (!_negocios.Any())
        {
            <div class="empty-state">
                <span class="material-symbols-rounded">inventory_2</span>
                <p>No hay datos para la fecha seleccionada.</p>
            </div>
        }
        else
        {
            @foreach (var neg in _negocios)
            {
                <MudCard Class="mb-3">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
                                <span style="font-size:14px;font-weight:700;color:var(--gray-dark);text-transform:uppercase;letter-spacing:0.03em;">@neg.TenantNombre</span>
                                <div class="neg-stats">
                                    <span class="neg-stat">
                                        <span class="material-symbols-rounded fill" style="font-size:14px;color:var(--em);">circle</span>
                                        <strong class="text-em">@neg.RepartidoresActivos</strong>
                                        <span style="font-size:11px;color:var(--gray-muted);">activos</span>
                                    </span>
                                    <span class="neg-stat">
                                        <span class="material-symbols-rounded fill" style="font-size:14px;color:var(--gray-muted);">circle</span>
                                        <strong>@neg.RepartidoresCerrados</strong>
                                        <span style="font-size:11px;color:var(--gray-muted);">cerrados</span>
                                    </span>
                                    <span class="tabnum fw-700 text-vi" style="font-size:14px;">
                                        @neg.TotalNeto.ToString("C0", _mx)
                                    </span>
                                    <span class="tabnum fw-700 text-in" style="font-size:15px;">
                                        @neg.TotalEfectivoEnCalle.ToString("C0", _mx)
                                    </span>
                                </div>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Style="padding:0;">
                        <MudTable Items="neg.Repartidores" Hover="true" Dense="true" Striped="false">
                            <HeaderContent>
                                <MudTh>Repartidor</MudTh>
                                <MudTh Style="text-align:right;">Neto</MudTh>
                                <MudTh Style="text-align:right;">Efectivo</MudTh>
                                <MudTh Style="text-align:center;">Estado</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd><span class="fw-500">@context.FullName</span></MudTd>
                                <MudTd Style="text-align:right;" Class="tabnum text-vi fw-600">
                                    @context.TotalNeto.ToString("C0", _mx)
                                </MudTd>
                                <MudTd Style="text-align:right;" Class="tabnum text-in fw-700">
                                    @context.TotalEfectivo.ToString("C0", _mx)
                                </MudTd>
                                <MudTd Style="text-align:center;">
                                    <MudChip T="string"
                                             Color="@(context.Estado == JornadaEstado.Abierta ? Color.Success : Color.Default)"
                                             Size="Size.Small" Variant="Variant.Filled">
                                        @(context.Estado == JornadaEstado.Abierta ? "Activo" : "Cerrado")
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            }
        }
    }

</div>

@code {
    private static readonly System.Globalization.CultureInfo _mx = new("es-MX");

    private List<DashboardNegocioDto> _negocios = new();
    private bool      _cargando = true;
    private DateTime? _fecha    = DateTime.Today;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task OnFechaChanged(DateTime? f) { _fecha = f; await Cargar(); }

    private async Task Cargar()
    {
        _cargando = true;
        var f = _fecha.HasValue ? DateOnly.FromDateTime(_fecha.Value) : DateOnly.FromDateTime(DateTime.Today);
        _negocios = await Api.GetDashboardGerenteAsync(f) ?? new();
        _cargando = false;
    }
}
