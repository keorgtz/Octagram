@page "/gerente/dashboard"
@attribute [Authorize(Roles = $"{nameof(UserRole.Gerente)},{nameof(UserRole.Admin)}")]
@inject ApiService Api

<PageTitle>Dashboard Gerente · OctagramDelivery</PageTitle>

<div style="padding:16px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:8px;">
        <h1 style="font-size:20px;font-weight:700;color:var(--gray-dark);margin:0;">Vista General</h1>
        <div style="display:flex;align-items:center;gap:8px;">
            <MudDatePicker Date="_fecha" DateChanged="OnFechaChanged" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudIconButton Icon="@Icons.Material.Rounded.Refresh" Color="Color.Primary" OnClick="Cargar" />
        </div>
    </div>

    @if (_cargando)
    {
        <div style="text-align:center;padding:48px;"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
    }
    else
    {
        <!-- KPI globales -->
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;margin-bottom:20px;">
            <div class="kpi-card" style="--accent-color:var(--in);">
                <div class="kpi-label">Negocios</div>
                <div class="kpi-value">@_negocios.Count</div>
            </div>
            <div class="kpi-card" style="--accent-color:var(--em);">
                <div class="kpi-label">Repartidores activos</div>
                <div class="kpi-value">@_negocios.Sum(n => n.RepartidoresActivos)</div>
            </div>
            <div class="kpi-card" style="--accent-color:var(--vi);">
                <div class="kpi-label">Neto Total</div>
                <div class="kpi-value" style="font-size:20px;">@_negocios.Sum(n => n.TotalNeto).ToString("C0", new System.Globalization.CultureInfo("es-MX"))</div>
            </div>
            <div class="kpi-card" style="--accent-color:var(--in);">
                <div class="kpi-label">Efectivo Total</div>
                <div class="kpi-value" style="font-size:20px;">@_negocios.Sum(n => n.TotalEfectivoEnCalle).ToString("C0", new System.Globalization.CultureInfo("es-MX"))</div>
            </div>
        </div>

        <!-- Un MudCard por negocio -->
        @foreach (var neg in _negocios)
        {
            <MudCard Class="mb-3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
                            <MudText Typo="Typo.h6" Style="font-weight:700;">@neg.TenantNombre</MudText>
                            <div style="display:flex;gap:8px;">
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">@neg.RepartidoresActivos activos</MudChip>
                                <MudChip T="string" Color="Color.Default" Size="Size.Small">@neg.RepartidoresCerrados cerrados</MudChip>
                            </div>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="padding:0;">
                    <MudTable Items="neg.Repartidores" Hover="true" Dense="true">
                        <HeaderContent>
                            <MudTh>Repartidor</MudTh>
                            <MudTh Style="text-align:right;">Neto</MudTh>
                            <MudTh Style="text-align:right;">Efectivo</MudTh>
                            <MudTh Style="text-align:center;">Estado</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.FullName</MudTd>
                            <MudTd Style="text-align:right;color:var(--vi);font-weight:600;font-variant-numeric:tabular-nums;">
                                @context.TotalNeto.ToString("C0", new System.Globalization.CultureInfo("es-MX"))
                            </MudTd>
                            <MudTd Style="text-align:right;color:var(--in);font-weight:700;font-variant-numeric:tabular-nums;">
                                @context.TotalEfectivo.ToString("C0", new System.Globalization.CultureInfo("es-MX"))
                            </MudTd>
                            <MudTd Style="text-align:center;">
                                <MudChip T="string" Color="@(context.Estado == JornadaEstado.Abierta ? Color.Success : Color.Default)" Size="Size.Small">
                                    @(context.Estado == JornadaEstado.Abierta ? "Activo" : "Cerrado")
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        }
    }
</div>

@code {
    private List<DashboardNegocioDto> _negocios = new();
    private bool _cargando = true;
    private DateTime? _fecha = DateTime.Today;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task OnFechaChanged(DateTime? f) { _fecha = f; await Cargar(); }

    private async Task Cargar()
    {
        _cargando = true;
        var f = _fecha.HasValue ? DateOnly.FromDateTime(_fecha.Value) : DateOnly.FromDateTime(DateTime.Today);
        _negocios = await Api.GetDashboardGerenteAsync(f) ?? new();
        _cargando = false;
    }
}
