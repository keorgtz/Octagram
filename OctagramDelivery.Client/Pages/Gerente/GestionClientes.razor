@page "/catalogos/clientes"
@attribute [Authorize(Roles = $"{nameof(UserRole.Gerente)},{nameof(UserRole.Supervisor)},{nameof(UserRole.Admin)}")]
@inject NavigationManager Nav
@inject ApiService Api
@inject AuthService AuthSvc
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>Clientes · TortiCloud</PageTitle>

<div class="page-content">
    <div class="page-header">
        <div>
            <h1 class="h-page-title">Clientes</h1>
            <p class="page-subtitle">Cartera de clientes del negocio</p>
        </div>
        <div class="page-header-actions">
            @if (_esGerente && _misNegocios.Count > 1)
            {
                <MudSelect T="int" Value="_negocioActivo" ValueChanged="CambiarNegocio"
                           Label="Negocio" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Style="min-width:180px;">
                    @foreach (var n in _misNegocios)
                    {
                        <MudSelectItem T="int" Value="n.Id">@n.Nombre</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudButton StartIcon="@Icons.Material.Rounded.GroupWork"
                       Variant="Variant.Text" Color="Color.Default"
                       Href="/catalogos/grupos">
                Grupos
            </MudButton>
            <MudButton StartIcon="@(_modoSeleccion ? Icons.Material.Rounded.Close : Icons.Material.Rounded.Checklist)"
                       Variant="@(_modoSeleccion ? Variant.Outlined : Variant.Text)"
                       Color="Color.Default" OnClick="ToggleModo"
                       Disabled="_negocioActivo == 0">
                @(_modoSeleccion ? "Cancelar" : "Seleccionar")
            </MudButton>
            <MudButton StartIcon="@Icons.Material.Rounded.PersonAdd"
                       Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="AbrirCrear" Disabled="_negocioActivo == 0">
                Nuevo Cliente
            </MudButton>
        </div>
    </div>

    @if (_cargando)
    {
        <div class="loading-state"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
    }
    else
    {
        @if (_modoSeleccion && _seleccionados.Count > 0)
        {
            <div class="seleccion-actionbar">
                <span class="seleccion-count">@_seleccionados.Count cliente@(_seleccionados.Count == 1 ? "" : "s") seleccionado@(_seleccionados.Count == 1 ? "" : "s")</span>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Rounded.Inventory"
                           OnClick="AbrirAsignacionMasiva">
                    Asignar producto
                </MudButton>
            </div>
        }

        <div class="data-card data-card-table">
            <!-- Desktop -->
            <div class="desk-only">
                <MudTable Items="_clientes" Hover="true" Dense="true" Striped="false" Filter="FiltrarCliente"
                          MultiSelection="@_modoSeleccion" @bind-SelectedItems="_seleccionados">
                    <ToolBarContent>
                        <MudTextField @bind-Value="_busqueda"
                                      Placeholder="Buscar cliente..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Rounded.Search"
                                      FullWidth="true" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Nombre</MudTh>
                        <MudTh>Teléfono</MudTh>
                        <MudTh>Días de entrega</MudTh>
                        <MudTh Style="text-align:center;">Productos</MudTh>
                        <MudTh Style="text-align:center;">Estado</MudTh>
                        <MudTh Style="width:90px;text-align:center;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div><span class="fw-600">@context.Nombre</span></div>
                            @if (!string.IsNullOrEmpty(context.Direccion))
                            {
                                <div style="font-size:11px;color:var(--gray-muted);">@context.Direccion</div>
                            }
                        </MudTd>
                        <MudTd><span class="text-muted">@(context.Telefono ?? "—")</span></MudTd>
                        <MudTd>
                            <span style="font-size:12px;letter-spacing:0.5px;">@FormatDias(context.DiasEntrega)</span>
                        </MudTd>
                        <MudTd Style="text-align:center;">
                            <span class="fw-600 text-primary">@context.Productos.Count</span>
                        </MudTd>
                        <MudTd Style="text-align:center;">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Color="@(context.IsActive ? Color.Success : Color.Default)">
                                @(context.IsActive ? "Activo" : "Inactivo")
                            </MudChip>
                        </MudTd>
                        <MudTd Style="text-align:center;">
                            <div style="display:inline-flex;gap:2px;align-items:center;">
                                <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                               Size="Size.Small" Color="Color.Default"
                                               title="Editar"
                                               OnClick="@(() => AbrirEditar(context))" />
                                <MudIconButton Icon="@Icons.Material.Rounded.Inventory"
                                               Size="Size.Small" Color="Color.Default"
                                               title="Asignar productos"
                                               OnClick="@(() => AbrirProductos(context))" />
                                <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                               Size="Size.Small" Color="Color.Default"
                                               title="Desactivar"
                                               OnClick="@(() => Eliminar(context))" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="empty-state">
                            <span class="material-symbols-rounded">people</span>
                            <p>No hay clientes registrados para este negocio.</p>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </div>
            <!-- Móvil -->
            <div class="mob-cards">
                <div class="mob-search-box">
                    <span class="material-symbols-rounded" style="color:var(--gray-muted);font-size:20px;flex-shrink:0;">search</span>
                    <input type="search" class="mob-srch-input" placeholder="Buscar cliente..."
                           @bind="_busqueda" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(_busqueda))
                    {
                        <button class="mob-srch-clear" @onclick="() => _busqueda = string.Empty">
                            <span class="material-symbols-rounded">close</span>
                        </button>
                    }
                </div>
                @{
                    var grupos = _clientes
                        .Where(c => !string.IsNullOrEmpty(c.Grupo))
                        .Select(c => c.Grupo!).Distinct().OrderBy(g => g).ToList();
                }
                @if (grupos.Count > 0)
                {
                    <div class="mob-grupo-chips">
                        <button class="mob-grupo-chip @(_filtroGrupo == null ? "active" : "")"
                                @onclick="() => _filtroGrupo = null">Todos</button>
                        @foreach (var g in grupos)
                        {
                            var gLocal = g;
                            <button class="mob-grupo-chip @(_filtroGrupo == gLocal ? "active" : "")"
                                    @onclick="() => _filtroGrupo = (_filtroGrupo == gLocal ? null : gLocal)">@g</button>
                        }
                    </div>
                }
                @{
                    var clientesFiltrados = _clientes.Where(FiltrarCliente).ToList();
                }
                @if (!clientesFiltrados.Any())
                {
                    <div class="empty-state">
                        <span class="material-symbols-rounded">people</span>
                        <p>No hay clientes registrados para este negocio.</p>
                    </div>
                }
                @foreach (var c in clientesFiltrados)
                {
                    var seleccionado = _seleccionados.Contains(c);
                    var infoSub = string.Join(" · ", new[] { c.Grupo, c.Direccion ?? c.Telefono }.Where(s => !string.IsNullOrEmpty(s)));
                    <div class="mob-lc @(seleccionado ? "mob-lc-selected" : "")"
                         @onclick="@(() => { if (_modoSeleccion) ToggleSeleccion(c); })">
                        <div class="lc-row">
                            @if (_modoSeleccion)
                            {
                                <div class="mob-lc-check @(seleccionado ? "on" : "")" style="margin-top:2px;flex-shrink:0;"></div>
                            }
                            <div class="lc-left">
                                <div class="mob-lc-name">@c.Nombre</div>
                                <div class="lc-tags">
                                    <span class="lc-tag @(c.IsActive ? "green" : "")">@(c.IsActive ? "Activo" : "Inactivo")</span>
                                    @if (!string.IsNullOrEmpty(infoSub))
                                    {
                                        <span class="lc-tag">@infoSub</span>
                                    }
                                    @if (c.DiasEntrega > 0)
                                    {
                                        <span class="lc-tag">@FormatDias(c.DiasEntrega)</span>
                                    }
                                </div>
                            </div>
                            @if (!_modoSeleccion)
                            {
                                <div class="lc-right">
                                    <div class="lc-count @(c.Productos.Count > 0 ? "" : "muted")">
                                        @(c.Productos.Count > 0 ? c.Productos.Count.ToString() : "—")
                                    </div>
                                    <div class="lc-count-label">prod</div>
                                </div>
                            }
                        </div>
                        @if (!_modoSeleccion)
                        {
                            <div class="mob-lc-acts">
                                <button class="mob-act-btn" @onclick:stopPropagation="true" @onclick="@(() => AbrirEditar(c))">
                                    <span class="material-symbols-rounded">edit</span>
                                </button>
                                <button class="mob-act-btn mob-act-primary" @onclick:stopPropagation="true" @onclick="@(() => AbrirProductos(c))">
                                    <span class="material-symbols-rounded">inventory_2</span>
                                    Productos
                                </button>
                                <button class="mob-act-btn mob-act-danger" @onclick:stopPropagation="true" @onclick="@(() => Eliminar(c))">
                                    <span class="material-symbols-rounded">delete</span>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Dialog datos del cliente -->
<MudDialog @bind-Visible="_dialogDatos">
    <TitleContent>
        <div style="display:flex;align-items:center;gap:10px;">
            <span class="material-symbols-rounded" style="color:var(--primary);font-size:20px;">person</span>
            <span>@(_esCrear ? "Nuevo Cliente" : "Editar Cliente")</span>
        </div>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_nombre" Label="Nombre del cliente"
                      Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Person" />
        <MudTextField @bind-Value="_direccion" Label="Dirección"
                      Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.LocationOn" />
        <MudTextField @bind-Value="_telefono" Label="Teléfono"
                      Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Phone" />
        <MudTextField @bind-Value="_grupo" Label="Grupo (opcional)"
                      Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Group" />
        <MudTimePicker @bind-Time="_horaAprox" Label="Hora aproximada de entrega"
                       Variant="Variant.Outlined" Style="width:100%;" Class="mb-3"
                       AmPm="false" />
        <div class="mb-1" style="font-size:12px;font-weight:600;color:var(--gray-muted);text-transform:uppercase;letter-spacing:.04em;">
            Días de entrega
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;">
            @foreach (var d in _diasOptions)
            {
                var activo = (_diasEntrega & d.Bit) != 0;
                <button class="@("dia-btn" + (activo ? " dia-btn-active" : ""))"
                        @onclick="@(() => ToggleDia(d.Bit))" type="button">
                    @d.Label
                </button>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CerrarDialogDatos">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarDatos">Guardar</MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog asignación de productos -->
<MudDialog @bind-Visible="_dialogProductos" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <div style="display:flex;align-items:center;gap:10px;">
            <span class="material-symbols-rounded" style="color:var(--primary);font-size:20px;">inventory</span>
            <span>Productos de @_clienteEditando?.Nombre</span>
        </div>
    </TitleContent>
    <DialogContent>
        @if (!_todosLosProductos.Any())
        {
            <div class="empty-state" style="padding:24px;">
                <span class="material-symbols-rounded">inventory_2</span>
                <p>No hay productos registrados en este negocio.</p>
            </div>
        }
        else
        {
            @foreach (var prod in _todosLosProductos)
            {
                var asig = _asignaciones.FirstOrDefault(a => a.ProductId == prod.Id);
                var activo = asig != null;
                <div style="padding:10px 0;border-bottom:1px solid var(--gray-line);">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <MudCheckBox T="bool" Value="activo"
                                     ValueChanged="@(v => ToggleProducto(prod.Id, v))"
                                     Color="Color.Primary" />
                        <div style="flex:1;min-width:0;">
                            <div class="fw-500" style="font-size:13px;">@prod.Nombre</div>
                            <div style="font-size:11px;color:var(--gray-muted);">
                                @(prod.TipoMedida == TipoMedida.Gramaje ? "Gramaje" : "Pieza") —
                                @prod.PrecioPorUnidad.ToString("C", _mx)
                                @(prod.TipoMedida == TipoMedida.Gramaje ? "/KG" : "")
                            </div>
                        </div>
                    </div>
                    @if (activo && asig != null)
                    {
                        <div style="display:flex;gap:10px;margin-top:8px;padding-left:44px;flex-wrap:wrap;">
                            <MudNumericField T="decimal" Value="asig.CantidadHabitual"
                                             ValueChanged="@(v => asig.CantidadHabitual = v)"
                                             Label="Cant. habitual" Style="width:110px;"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Min="0"
                                             Format="@(prod.TipoMedida == TipoMedida.Gramaje ? "F2" : "F0")" />
                            <MudSelect T="int?" Value="asig.PriceTierId"
                                       ValueChanged="@(v => asig.PriceTierId = v)"
                                       Label="Perfil" Style="flex:1;min-width:160px;"
                                       Variant="Variant.Outlined" Margin="Margin.Dense"
                                       Clearable="false">
                                <MudSelectItem T="int?" Value="(int?)null">
                                    Base — @prod.PrecioPorUnidad.ToString("C", _mx)
                                </MudSelectItem>
                                @foreach (var tier in prod.Perfiles.OrderBy(t => t.Numero))
                                {
                                    <MudSelectItem T="int?" Value="(int?)tier.Id">
                                        Perfil @tier.Numero@(tier.Etiqueta != null ? " · " + tier.Etiqueta : "") — @tier.Precio.ToString("C", _mx)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    }
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => _dialogProductos = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarProductos">Guardar</MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog asignación masiva de producto -->
<MudDialog @bind-Visible="_dialogAsignacionMasiva"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <div style="display:flex;align-items:center;gap:10px;">
            <span class="material-symbols-rounded" style="color:var(--primary);font-size:20px;">inventory_2</span>
            <span>Asignar a @_seleccionados.Count cliente@(_seleccionados.Count == 1 ? "" : "s")</span>
        </div>
    </TitleContent>
    <DialogContent>
        <p style="font-size:12px;color:var(--gray-muted);margin-bottom:14px;">
            El producto y perfil seleccionados se asignarán a todos los clientes seleccionados.
        </p>
        <MudSelect T="int" @bind-Value="_masProductoId" Label="Producto"
                   Variant="Variant.Outlined" FullWidth="true" Class="mb-3">
            @foreach (var p in _todosLosProductos)
            {
                <MudSelectItem T="int" Value="p.Id">@p.Nombre</MudSelectItem>
            }
        </MudSelect>
        @if (_masProductoActivo != null)
        {
            <MudNumericField T="decimal" @bind-Value="_masCantidad"
                             Label="Cantidad habitual"
                             Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                             Min="0"
                             Format="@(_masProductoActivo.TipoMedida == TipoMedida.Gramaje ? "F2" : "F0")" />
            <MudSelect T="int?" @bind-Value="_masPerfil" Label="Perfil de precio"
                       Variant="Variant.Outlined" FullWidth="true" Clearable="false">
                <MudSelectItem T="int?" Value="(int?)null">
                    Base — @_masProductoActivo.PrecioPorUnidad.ToString("C", _mx)
                </MudSelectItem>
                @foreach (var t in _masProductoActivo.Perfiles.OrderBy(t => t.Numero))
                {
                    <MudSelectItem T="int?" Value="(int?)t.Id">
                        Perfil @t.Numero@(t.Etiqueta != null ? " · " + t.Etiqueta : "") — @t.Precio.ToString("C", _mx)
                    </MudSelectItem>
                }
            </MudSelect>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => _dialogAsignacionMasiva = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="ConfirmarAsignacionMasiva"
                   Disabled="@(_masProductoId == 0 || _guardandoMasivo)">
            @if (_guardandoMasivo)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Asignar a todos
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly System.Globalization.CultureInfo _mx =
        System.Globalization.CultureInfo.GetCultureInfo("es-MX");

    private static readonly (int Bit, string Label)[] _diasOptions =
    {
        (1, "L"), (2, "M"), (4, "X"), (8, "J"), (16, "V"), (32, "S"), (64, "D")
    };

    private List<CustomerDto> _clientes       = new();
    private List<ProductDto>  _todosLosProductos = new();
    private List<TenantDto>   _misNegocios    = new();
    private bool _cargando = true;
    private bool _esGerente;
    private int  _negocioActivo;
    private string  _busqueda    = "";
    private string? _filtroGrupo;

    // Dialog datos del cliente
    private bool     _dialogDatos;
    private bool     _esCrear;
    private int      _editId;
    private string   _nombre    = "";
    private string?  _direccion;
    private string?  _telefono;
    private string?  _grupo;
    private TimeSpan? _horaAprox;
    private int      _diasEntrega;

    // Dialog productos del cliente
    private bool _dialogProductos;
    private CustomerDto? _clienteEditando;
    private List<ProductAssignItem> _asignaciones = new();

    // Selección masiva
    private bool _modoSeleccion;
    private HashSet<CustomerDto> _seleccionados = new();
    private bool _dialogAsignacionMasiva;
    private int _masProductoId;
    private decimal _masCantidad = 1;
    private int? _masPerfil;
    private bool _guardandoMasivo;
    private ProductDto? _masProductoActivo => _todosLosProductos.FirstOrDefault(p => p.Id == _masProductoId);

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthSvc.GetCurrentUser();
        _esGerente = user?.Rol == UserRole.Gerente || user?.Rol == UserRole.Admin;

        if (_esGerente)
        {
            _misNegocios   = await Api.GetNegociosAsync() ?? new();
            _negocioActivo = _misNegocios.FirstOrDefault()?.Id ?? 0;
        }
        else
        {
            _negocioActivo = user?.NegocioIds.FirstOrDefault() ?? 0;
        }

        // Gate: Supervisor necesita GestionClientes
        if (user?.Rol == UserRole.Supervisor && _negocioActivo > 0
            && !user.TienePermiso(Permiso.GestionClientes, _negocioActivo))
        {
            Nav.NavigateTo("/");
            return;
        }

        if (_negocioActivo != 0) await Cargar();
        _cargando = false;
    }

    private async Task CambiarNegocio(int id) { _negocioActivo = id; await Cargar(); }

    private async Task Cargar()
    {
        _cargando = true;
        (_clientes, _todosLosProductos) = (
            await Api.GetClientesAsync(_negocioActivo) ?? new(),
            await Api.GetProductosAsync(_negocioActivo) ?? new()
        );
        _cargando = false;
    }

    private bool FiltrarCliente(CustomerDto c) =>
        (string.IsNullOrEmpty(_busqueda) || c.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)) &&
        (_filtroGrupo == null || c.Grupo == _filtroGrupo);

    // ── Selección masiva ──────────────────────────────────────────
    private void ToggleModo()
    {
        _modoSeleccion = !_modoSeleccion;
        _seleccionados.Clear();
    }

    private void ToggleSeleccion(CustomerDto c)
    {
        if (_seleccionados.Contains(c)) _seleccionados.Remove(c);
        else _seleccionados.Add(c);
    }

    private void AbrirAsignacionMasiva()
    {
        _masProductoId = 0; _masCantidad = 1; _masPerfil = null;
        _dialogAsignacionMasiva = true;
    }

    private async Task ConfirmarAsignacionMasiva()
    {
        if (_masProductoId == 0) { Snackbar.Add("Selecciona un producto.", Severity.Warning); return; }
        _guardandoMasivo = true;
        var req = new AssignProductsRequest
        {
            Productos = [new ProductAssignItem
            {
                ProductId        = _masProductoId,
                CantidadHabitual = _masCantidad,
                PriceTierId      = _masPerfil
            }]
        };
        int ok = 0, fail = 0;
        foreach (var cliente in _seleccionados.ToList())
        {
            var resp = await Api.AssignProductosClienteAsync(_negocioActivo, cliente.Id, req);
            if (resp.IsSuccessStatusCode) ok++; else fail++;
        }
        _guardandoMasivo = false;
        Snackbar.Add(
            fail == 0 ? $"Producto asignado a {ok} cliente{(ok == 1 ? "" : "s")}." : $"{ok} asignados, {fail} fallaron.",
            fail == 0 ? Severity.Success : Severity.Warning);
        _dialogAsignacionMasiva = false;
        ToggleModo();
        await Cargar();
    }

    // ── Dialog datos ──────────────────────────────────────────────
    private void AbrirCrear()
    {
        _esCrear = true; _editId = 0;
        _nombre = ""; _direccion = null; _telefono = null;
        _horaAprox = null; _diasEntrega = 0; _grupo = null;
        _dialogDatos = true;
    }

    private void AbrirEditar(CustomerDto c)
    {
        _esCrear = false; _editId = c.Id;
        _nombre = c.Nombre; _direccion = c.Direccion; _telefono = c.Telefono;
        _horaAprox = c.HoraAproximada; _diasEntrega = c.DiasEntrega; _grupo = c.Grupo;
        _dialogDatos = true;
    }

    private void CerrarDialogDatos() => _dialogDatos = false;

    private void ToggleDia(int bit) => _diasEntrega ^= bit;

    private async Task GuardarDatos()
    {
        if (string.IsNullOrWhiteSpace(_nombre)) { Snackbar.Add("El nombre es requerido.", Severity.Warning); return; }
        var req = new CreateCustomerRequest
        {
            Nombre = _nombre, Direccion = _direccion, Telefono = _telefono,
            DiasEntrega = _diasEntrega, HoraAproximada = _horaAprox, Grupo = _grupo
        };
        var resp = _esCrear
            ? await Api.CreateClienteAsync(_negocioActivo, req)
            : await Api.UpdateClienteAsync(_negocioActivo, _editId, req);

        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Cliente guardado.", Severity.Success);
            CerrarDialogDatos(); await Cargar();
        }
        else Snackbar.Add("Error al guardar el cliente.", Severity.Error);
    }

    // ── Dialog productos ──────────────────────────────────────────
    private void AbrirProductos(CustomerDto c)
    {
        _clienteEditando = c;
        _asignaciones = c.Productos.Select(p => new ProductAssignItem
        {
            ProductId        = p.ProductId,
            CantidadHabitual = p.CantidadHabitual,
            PriceTierId      = p.PriceTierId
        }).ToList();
        _dialogProductos = true;
    }

    private void ToggleProducto(int productId, bool incluir)
    {
        if (incluir)
        {
            if (!_asignaciones.Any(a => a.ProductId == productId))
                _asignaciones.Add(new ProductAssignItem { ProductId = productId, CantidadHabitual = 1 });
        }
        else
        {
            _asignaciones.RemoveAll(a => a.ProductId == productId);
        }
    }

    private async Task GuardarProductos()
    {
        var req = new AssignProductsRequest { Productos = _asignaciones };
        var resp = await Api.AssignProductosClienteAsync(_negocioActivo, _clienteEditando!.Id, req);
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Productos del cliente actualizados.", Severity.Success);
            _dialogProductos = false;
            await Cargar();
        }
        else Snackbar.Add("Error al guardar los productos.", Severity.Error);
    }

    private async Task Eliminar(CustomerDto c)
    {
        var ok = await Dialog.ShowMessageBox("Desactivar cliente",
            $"¿Desactivar a \"{c.Nombre}\"?", yesText: "Desactivar", cancelText: "Cancelar");
        if (ok == true)
        {
            await Api.DeleteClienteAsync(_negocioActivo, c.Id);
            Snackbar.Add("Cliente desactivado.", Severity.Warning);
            await Cargar();
        }
    }

    private static string FormatDias(int bitmask)
    {
        if (bitmask == 0) return "Todos";
        var labels = new[] { "L", "M", "X", "J", "V", "S", "D" };
        var bits   = new[] { 1, 2, 4, 8, 16, 32, 64 };
        return string.Join(" ", bits.Select((b, i) => (bitmask & b) != 0 ? labels[i] : null)
                                    .Where(l => l != null));
    }
}
