@page "/gerente/jornadas"
@attribute [Authorize(Roles = $"{nameof(UserRole.Gerente)},{nameof(UserRole.Admin)},{nameof(UserRole.Supervisor)}")]
@inject ApiService Api
@inject AuthService AuthSvc
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject HubService Hub
@implements IAsyncDisposable

<PageTitle>Jornadas · TortiCloud</PageTitle>

<div class="page-content">
    <div class="page-header">
        <div>
            <h1 class="h-page-title">Jornadas de Hoy</h1>
            <p class="page-subtitle">@DateTime.Today.ToString("dddd d 'de' MMMM", _mx)</p>
        </div>
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            @if (_esAdmin && _negocios.Count > 1)
            {
                <MudSelect T="int" Value="_negocioActivo" ValueChanged="CambiarNegocio"
                           Label="Negocio" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Style="min-width:180px;">
                    @foreach (var n in _negocios)
                    {
                        <MudSelectItem T="int" Value="n.Id">@n.Nombre</MudSelectItem>
                    }
                </MudSelect>
            }
        </div>
    </div>

    @if (_esAdmin && _repartidores.Count > 0)
    {
        <div class="joropen-card">
            <button class="joropen-toggle" @onclick="() => _abrirExpanded = !_abrirExpanded">
                <span class="material-symbols-rounded" style="color:var(--em,#10B981);">add_task</span>
                <span>Abrir jornada para repartidor</span>
                <span class="material-symbols-rounded" style="margin-left:auto;color:var(--gray-muted);font-size:20px;">
                    @(_abrirExpanded ? "expand_less" : "expand_more")
                </span>
            </button>
            @if (_abrirExpanded)
            {
                <div class="joropen-panel">
                    <MudSelect T="int" @bind-Value="_repartidorId" Label="Repartidor"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Style="flex:1;min-width:200px;">
                        <MudSelectItem T="int" Value="0" Disabled="true">Selecciona un repartidor</MudSelectItem>
                        @foreach (var u in _repartidores)
                        {
                            <MudSelectItem T="int" Value="u.UserId">@u.FullName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="@(_abriendo || _repartidorId == 0)"
                               OnClick="AbrirJornadaParaRepartidor"
                               StartIcon="@Icons.Material.Rounded.PlayCircle">
                        @(_abriendo ? "Abriendo…" : "Abrir")
                    </MudButton>
                </div>
            }
        </div>
    }

    @if (_cargando)
    {
        <div style="display:flex;justify-content:center;padding:48px;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (_jornadas.Count == 0)
    {
        <div class="empty-state" style="padding:48px 0;">
            <span class="material-symbols-rounded">delivery_dining</span>
            <p>No hay jornadas registradas hoy en este negocio.</p>
        </div>
    }
    else
    {
        <div class="jornadas-activas-grid">
            @foreach (var j in _jornadas.OrderBy(j => j.RepartidorNombre).ThenBy(j => j.FechaApertura))
            {
                var numJornada    = GetNumJornada(j);
                var tieneMultiple = TieneMultiplesJornadas(j.DriverId);
                <div class="jornada-monitor-card" @onclick="() => Monitorear(j.Id)">
                    <div class="jornada-monitor-header">
                        <span class="material-symbols-rounded jornada-monitor-icon">person</span>
                        <div style="flex:1;min-width:0;">
                            <div class="jornada-monitor-nombre">@j.RepartidorNombre</div>
                            @if (tieneMultiple)
                            {
                                <div style="font-size:11px;color:var(--gray-muted);">
                                    Jornada @numJornada · @j.FechaApertura.ToLocalTime().ToString("hh:mm tt")
                                </div>
                            }
                        </div>
                        @if (j.Estado == JornadaEstado.Abierta)
                        {
                            <span class="jornada-estado-badge abierta">● Activa</span>
                        }
                        else
                        {
                            <span class="jornada-estado-badge cerrada">Cerrada</span>
                        }
                    </div>
                    <div class="jornada-monitor-totales">
                        <div class="jornada-monitor-kpi">
                            <span class="jornada-monitor-kpi-label">Neto</span>
                            <span class="jornada-monitor-kpi-value text-vi">@j.TotalNeto.ToString("C", _mx)</span>
                        </div>
                    </div>
                    <div class="jornada-monitor-action">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Rounded.Visibility"
                                   OnClick="@(() => Monitorear(j.Id))">
                            Ver jornada
                        </MudButton>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo _mx =
        System.Globalization.CultureInfo.GetCultureInfo("es-MX");

    private bool _cargando = true;
    private bool _esAdmin;
    private int _negocioActivo;
    private List<TenantDto> _negocios = new();
    private List<JornadaResumenDto> _jornadas = new();
    private List<UsuarioNegocioDto> _repartidores = new();
    private int  _repartidorId;
    private bool _abrirExpanded;
    private bool _abriendo;

    // Índice precalculado: DriverId → lista ordenada por FechaApertura
    private Dictionary<int, List<JornadaResumenDto>> _jornadasPorDriver = new();

    // SignalR subscriptions
    private IDisposable? _subAbierta;
    private IDisposable? _subCerrada;

    private int  GetNumJornada(JornadaResumenDto j)
        => _jornadasPorDriver.TryGetValue(j.DriverId, out var lst) ? lst.IndexOf(j) + 1 : 1;

    private bool TieneMultiplesJornadas(int driverId)
        => _jornadasPorDriver.TryGetValue(driverId, out var lst) && lst.Count > 1;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthSvc.GetCurrentUser();
        _esAdmin = user?.Rol == UserRole.Admin || user?.Rol == UserRole.Gerente;

        if (_esAdmin)
        {
            _negocios      = await Api.GetNegociosAsync() ?? new();
            _negocioActivo = _negocios.FirstOrDefault()?.Id ?? 0;
        }
        else
        {
            _negocioActivo = user?.NegocioIds.FirstOrDefault() ?? 0;
        }

        if (_negocioActivo > 0)
            await Task.WhenAll(Cargar(), CargarRepartidores());

        _cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _negocioActivo == 0) return;
        try
        {
            await Hub.ConnectAsync();
            await Hub.JoinNegocioAsync(_negocioActivo);
            _subAbierta = Hub.On<object>("JornadaAbierta", async _ =>
                await InvokeAsync(async () => { await Cargar(); StateHasChanged(); }));
            _subCerrada = Hub.On<object>("JornadaCerrada", async _ =>
                await InvokeAsync(async () => { await Cargar(); StateHasChanged(); }));
        }
        catch { /* sin conexión al hub, la página funciona igual sin tiempo real */ }
    }

    private async Task CambiarNegocio(int id)
    {
        var anterior = _negocioActivo;
        _negocioActivo = id;
        _repartidorId  = 0;
        await Task.WhenAll(Cargar(), CargarRepartidores());
        // Reubicar el grupo en el hub si está conectado
        try
        {
            if (Hub.IsConnected)
            {
                await Hub.LeaveNegocioAsync(anterior);
                await Hub.JoinNegocioAsync(_negocioActivo);
            }
        }
        catch { }
    }

    private async Task Cargar()
    {
        _cargando = true;
        _jornadas = await Api.GetJornadasNegocioHoyAsync(_negocioActivo) ?? new();
        _jornadasPorDriver = _jornadas
            .GroupBy(j => j.DriverId)
            .ToDictionary(g => g.Key, g => g.OrderBy(j => j.FechaApertura).ToList());
        _cargando = false;
    }

    private async Task CargarRepartidores()
    {
        if (_negocioActivo == 0) return;
        var todos = await Api.GetUsuariosNegocioAsync(_negocioActivo) ?? new();
        _repartidores = todos.Where(u => u.Rol == UserRole.Repartidor && u.IsActive).ToList();
    }

    private async Task AbrirJornadaParaRepartidor()
    {
        if (_repartidorId == 0 || _abriendo) return;
        _abriendo = true;
        StateHasChanged();
        try
        {
            var resp = await Api.AbrirJornadaAsync(new OpenJornadaRequest
            {
                TenantId   = _negocioActivo,
                DriverId   = _repartidorId,
                LocalFecha = DateOnly.FromDateTime(DateTime.Today)
            });
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Jornada abierta correctamente", Severity.Success);
                _abrirExpanded = false;
                _repartidorId  = 0;
                await Cargar();
            }
            else
            {
                var msg = await resp.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al abrir: {msg}", Severity.Error);
            }
        }
        catch { Snackbar.Add("Error de conexión", Severity.Error); }
        _abriendo = false;
    }

    private void Monitorear(int jornadaId)
        => Nav.NavigateTo($"/gerente/jornada/{jornadaId}");

    public async ValueTask DisposeAsync()
    {
        _subAbierta?.Dispose();
        _subCerrada?.Dispose();
        await Hub.DisposeAsync();
    }
}
