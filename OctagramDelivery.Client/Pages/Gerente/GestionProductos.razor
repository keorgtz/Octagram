@page "/gerente/productos"
@page "/supervisor/productos"
@attribute [Authorize(Roles = $"{nameof(UserRole.Gerente)},{nameof(UserRole.Supervisor)},{nameof(UserRole.Admin)}")]
@inject ApiService Api
@inject AuthService AuthSvc
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>Productos · OctagramDelivery</PageTitle>

<div class="page-content">
    <div class="page-header">
        <div>
            <h1 class="h-page-title">Productos</h1>
            <p class="page-subtitle">Catálogo de productos y perfiles de precio</p>
        </div>
        <div class="page-header-actions">
            @if (_esGerente && _misNegocios.Count > 1)
            {
                <MudSelect T="int" Value="_negocioActivo" ValueChanged="CambiarNegocio"
                           Label="Negocio" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Style="min-width:180px;">
                    @foreach (var n in _misNegocios)
                    {
                        <MudSelectItem T="int" Value="n.Id">@n.Nombre</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudButton StartIcon="@Icons.Material.Rounded.Add"
                       Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="AbrirCrear" Disabled="_negocioActivo == 0">
                Nuevo Producto
            </MudButton>
        </div>
    </div>

    @if (_cargando)
    {
        <div class="loading-state"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
    }
    else
    {
        <div class="data-card">
            <MudTable Items="_productos" Hover="true" Dense="true" Striped="false" T="ProductDto">
                <HeaderContent>
                    <MudTh Style="width:28px;"></MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh Style="text-align:center;">Tipo</MudTh>
                    <MudTh Style="text-align:right;">Precio base</MudTh>
                    <MudTh Style="text-align:center;">Perfiles</MudTh>
                    <MudTh Style="width:80px;text-align:center;">Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="padding:0 4px;">
                        <MudIconButton Icon="@(_expandedIds.Contains(context.Id) ? Icons.Material.Rounded.ExpandLess : Icons.Material.Rounded.ExpandMore)"
                                       Size="Size.Small" Color="Color.Default"
                                       OnClick="@(() => ToggleExpand(context.Id))" />
                    </MudTd>
                    <MudTd><span class="fw-600">@context.Nombre</span></MudTd>
                    <MudTd Style="text-align:center;">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                 Color="@(context.TipoMedida == TipoMedida.Gramaje ? Color.Info : Color.Default)">
                            @(context.TipoMedida == TipoMedida.Gramaje ? "Gramaje" : "Pieza")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align:right;" Class="tabnum">
                        @context.PrecioPorUnidad.ToString("C", _mx)
                        @if (context.TipoMedida == TipoMedida.Gramaje)
                        { <span class="text-muted" style="font-size:10px;"> /KG</span> }
                    </MudTd>
                    <MudTd Style="text-align:center;">
                        @if (context.Perfiles.Count > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success">
                                @context.Perfiles.Count
                            </MudChip>
                        }
                        else
                        {
                            <span style="font-size:11px;color:var(--gray-muted);">—</span>
                        }
                    </MudTd>
                    <MudTd Style="text-align:center;">
                        <div style="display:inline-flex;gap:2px;align-items:center;">
                            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                           Size="Size.Small" Color="Color.Default" title="Editar"
                                           OnClick="@(() => AbrirEditar(context))" />
                            <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                           Size="Size.Small" Color="Color.Default" title="Desactivar"
                                           OnClick="@(() => Eliminar(context))" />
                        </div>
                    </MudTd>
                </RowTemplate>
                <ChildRowContent Context="prod">
                    @if (_expandedIds.Contains(prod.Id))
                    {
                        <td colspan="6" style="padding:0;background:var(--page-bg);">
                            <div style="padding:12px 20px 16px;">
                                <div style="font-size:11px;font-weight:700;text-transform:uppercase;
                                            letter-spacing:.05em;color:var(--gray-muted);margin-bottom:10px;">
                                    Perfiles de precio · @prod.Nombre
                                </div>

                                @if (prod.Perfiles.Any())
                                {
                                    <table style="width:100%;border-collapse:collapse;font-size:13px;margin-bottom:12px;">
                                        <thead>
                                            <tr style="border-bottom:1px solid var(--gray-line);">
                                                <th style="text-align:left;padding:4px 8px;font-weight:700;font-size:11px;color:var(--gray-muted);text-transform:uppercase;">Nro</th>
                                                <th style="text-align:left;padding:4px 8px;font-weight:700;font-size:11px;color:var(--gray-muted);text-transform:uppercase;">Etiqueta</th>
                                                <th style="text-align:right;padding:4px 8px;font-weight:700;font-size:11px;color:var(--gray-muted);text-transform:uppercase;">Precio</th>
                                                <th style="width:60px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var tier in prod.Perfiles.OrderBy(t => t.Numero))
                                            {
                                                <tr style="border-bottom:1px solid var(--gray-line);">
                                                    <td style="padding:6px 8px;">
                                                        <span class="fw-700" style="color:var(--primary);">@tier.Numero</span>
                                                    </td>
                                                    <td style="padding:6px 8px;">
                                                        <span class="text-muted">@(tier.Etiqueta ?? "—")</span>
                                                    </td>
                                                    <td style="padding:6px 8px;text-align:right;" class="tabnum fw-600 text-em">
                                                        @tier.Precio.ToString("C", _mx)
                                                    </td>
                                                    <td style="padding:2px 4px;">
                                                        <div style="display:inline-flex;gap:2px;">
                                                            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                                                           Size="Size.Small" Color="Color.Default"
                                                                           OnClick="@(() => AbrirEditarTier(prod, tier))" />
                                                            <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                                                           Size="Size.Small" Color="Color.Default"
                                                                           OnClick="@(() => EliminarTier(prod, tier))" />
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div style="font-size:12px;color:var(--gray-muted);margin-bottom:12px;">
                                        Sin perfiles configurados. Todos los clientes usarán el precio base.
                                    </div>
                                }

                                @if (_tierProductoId == prod.Id)
                                {
                                    <div class="tier-form">
                                        <MudNumericField T="int" @bind-Value="_tierNumero" Label="Nro"
                                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                                         Style="width:70px;" Min="1" />
                                        <MudTextField @bind-Value="_tierEtiqueta" Label="Etiqueta (opcional)"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      Style="width:160px;" />
                                        <MudNumericField T="decimal" @bind-Value="_tierPrecio" Label="Precio"
                                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                                         Style="width:120px;" Min="0" Format="F2" Culture="_mx"
                                                         Adornment="Adornment.Start" AdornmentText="$" />
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                   OnClick="@(() => GuardarTier(prod))">
                                            Guardar
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   OnClick="CerrarTierForm">
                                            Cancelar
                                        </MudButton>
                                    </div>
                                }
                                else
                                {
                                    <MudButton StartIcon="@Icons.Material.Rounded.Add"
                                               Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                               OnClick="@(() => AbrirCrearTier(prod))">
                                        Agregar Perfil
                                    </MudButton>
                                }
                            </div>
                        </td>
                    }
                </ChildRowContent>
                <NoRecordsContent>
                    <div class="empty-state">
                        <span class="material-symbols-rounded">inventory_2</span>
                        <p>No hay productos registrados para este negocio.</p>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </div>
    }
</div>

<!-- Dialog crear/editar producto -->
<MudDialog @bind-Visible="_dialogOpen">
    <TitleContent>
        <div style="display:flex;align-items:center;gap:10px;">
            <span class="material-symbols-rounded" style="color:var(--primary);font-size:20px;">inventory_2</span>
            <span>@(_esCrear ? "Nuevo Producto" : "Editar Producto")</span>
        </div>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_nombre" Label="Nombre del producto"
                      Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Label" />
        <MudSelect T="TipoMedida" @bind-Value="_tipoMedida" Label="Tipo de medida"
                   Variant="Variant.Outlined" FullWidth="true" Class="mb-3">
            <MudSelectItem T="TipoMedida" Value="TipoMedida.Pieza">Pieza (por unidad)</MudSelectItem>
            <MudSelectItem T="TipoMedida" Value="TipoMedida.Gramaje">Gramaje (precio por KG)</MudSelectItem>
        </MudSelect>
        <MudNumericField T="decimal" @bind-Value="_precio"
                         Label="@(_tipoMedida == TipoMedida.Gramaje ? "Precio base por KG" : "Precio base por pieza")"
                         Variant="Variant.Outlined" FullWidth="true" Min="0"
                         Adornment="Adornment.Start" AdornmentText="$"
                         Format="F2" Culture="_mx" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CerrarDialog">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Guardar">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly System.Globalization.CultureInfo _mx =
        System.Globalization.CultureInfo.GetCultureInfo("es-MX");

    private List<ProductDto>  _productos   = new();
    private List<TenantDto>   _misNegocios = new();
    private bool _cargando = true;
    private bool _esGerente;
    private int  _negocioActivo;

    // Expand state for tiers
    private HashSet<int> _expandedIds = new();

    // Product dialog
    private bool       _dialogOpen, _esCrear;
    private int        _editId;
    private string     _nombre    = "";
    private TipoMedida _tipoMedida = TipoMedida.Pieza;
    private decimal    _precio;

    // Tier inline form
    private int     _tierProductoId;
    private int     _tierEditId;
    private int     _tierNumero = 1;
    private string? _tierEtiqueta;
    private decimal _tierPrecio;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthSvc.GetCurrentUser();
        _esGerente = user?.Rol == UserRole.Gerente;

        if (_esGerente)
        {
            _misNegocios   = await Api.GetNegociosAsync() ?? new();
            _negocioActivo = _misNegocios.FirstOrDefault()?.Id ?? 0;
        }
        else
        {
            _negocioActivo = user?.NegocioIds.FirstOrDefault() ?? 0;
        }

        if (_negocioActivo != 0) await Cargar();
        _cargando = false;
    }

    private async Task CambiarNegocio(int id) { _negocioActivo = id; _expandedIds.Clear(); await Cargar(); }

    private async Task Cargar()
    {
        _cargando = true;
        _productos = await Api.GetProductosAsync(_negocioActivo) ?? new();
        _cargando = false;
    }

    private void ToggleExpand(int prodId)
    {
        if (_expandedIds.Contains(prodId)) _expandedIds.Remove(prodId);
        else _expandedIds.Add(prodId);
        CerrarTierForm();
    }

    // ── Producto CRUD ─────────────────────────────────────────────
    private void AbrirCrear()
    {
        _esCrear = true; _editId = 0;
        _nombre = ""; _tipoMedida = TipoMedida.Pieza; _precio = 0;
        _dialogOpen = true;
    }

    private void AbrirEditar(ProductDto p)
    {
        _esCrear = false; _editId = p.Id;
        _nombre = p.Nombre; _tipoMedida = p.TipoMedida; _precio = p.PrecioPorUnidad;
        _dialogOpen = true;
    }

    private void CerrarDialog() => _dialogOpen = false;

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(_nombre)) { Snackbar.Add("El nombre es requerido.", Severity.Warning); return; }
        var req = new CreateProductRequest { Nombre = _nombre, TipoMedida = _tipoMedida, PrecioPorUnidad = _precio };
        var resp = _esCrear
            ? await Api.CreateProductoAsync(_negocioActivo, req)
            : await Api.UpdateProductoAsync(_negocioActivo, _editId, req);

        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Producto guardado.", Severity.Success);
            CerrarDialog(); await Cargar();
        }
        else Snackbar.Add("Error al guardar el producto.", Severity.Error);
    }

    private async Task Eliminar(ProductDto p)
    {
        var ok = await Dialog.ShowMessageBox("Desactivar producto",
            $"¿Desactivar \"{p.Nombre}\"?", yesText: "Desactivar", cancelText: "Cancelar");
        if (ok == true)
        {
            await Api.DeleteProductoAsync(_negocioActivo, p.Id);
            Snackbar.Add("Producto desactivado.", Severity.Warning);
            await Cargar();
        }
    }

    // ── Perfiles de precio ────────────────────────────────────────
    private void AbrirCrearTier(ProductDto prod)
    {
        _tierProductoId = prod.Id;
        _tierEditId     = 0;
        _tierNumero     = (prod.Perfiles.Any() ? prod.Perfiles.Max(t => t.Numero) + 1 : 1);
        _tierEtiqueta   = null;
        _tierPrecio     = prod.PrecioPorUnidad;
    }

    private void AbrirEditarTier(ProductDto prod, PriceTierDto tier)
    {
        _tierProductoId = prod.Id;
        _tierEditId     = tier.Id;
        _tierNumero     = tier.Numero;
        _tierEtiqueta   = tier.Etiqueta;
        _tierPrecio     = tier.Precio;
        _expandedIds.Add(prod.Id);
    }

    private void CerrarTierForm() => _tierProductoId = 0;

    private async Task GuardarTier(ProductDto prod)
    {
        var req = new UpsertPriceTierRequest { Numero = _tierNumero, Etiqueta = _tierEtiqueta, Precio = _tierPrecio };
        var resp = _tierEditId == 0
            ? await Api.CreatePerfilAsync(_negocioActivo, prod.Id, req)
            : await Api.UpdatePerfilAsync(_negocioActivo, prod.Id, _tierEditId, req);

        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Perfil guardado.", Severity.Success);
            CerrarTierForm();
            await Cargar();
        }
        else Snackbar.Add("Error al guardar el perfil.", Severity.Error);
    }

    private async Task EliminarTier(ProductDto prod, PriceTierDto tier)
    {
        var ok = await Dialog.ShowMessageBox("Eliminar perfil",
            $"¿Eliminar el Perfil {tier.Numero} de \"{prod.Nombre}\"?",
            yesText: "Eliminar", cancelText: "Cancelar");
        if (ok == true)
        {
            await Api.DeletePerfilAsync(_negocioActivo, prod.Id, tier.Id);
            Snackbar.Add("Perfil eliminado.", Severity.Warning);
            await Cargar();
        }
    }
}
