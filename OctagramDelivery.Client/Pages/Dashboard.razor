@page "/dashboard"
@using OctagramDelivery.Shared.Models
@inject HttpClient Http

<PageTitle>Dashboard de Control</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Panel de Control</h1>
    <span class="badge bg-primary fs-5">Modo: Supervisor</span>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm text-center border-0 h-100">
            <div class="card-body">
                <h5 class="text-muted">Repartidores Activos</h5>
                <h2 class="display-4 fw-bold text-dark">5</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center border-0 h-100">
            <div class="card-body">
                <h5 class="text-muted">Total Efectivo a Rendir</h5>
                <h2 class="display-4 fw-bold text-success">$14,250</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center border-0 h-100">
            <div class="card-body">
                <h5 class="text-muted">Devoluciones (Gramos/Pzas)</h5>
                <h2 class="display-4 fw-bold text-danger">12.5</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center border-0 h-100">
            <div class="card-body">
                <h5 class="text-muted">Pagos con Transferencia</h5>
                <h2 class="display-4 fw-bold text-info">$3,100</h2>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
        <h4 class="mb-0">Rendimiento por Repartidor</h4>
    </div>
    <div class="card-body table-responsive">
        <table class="table table-hover align-middle mt-3">
            <thead class="table-light">
                <tr>
                    <th>Repartidor</th>
                    <th>Vueltas Completadas</th>
                    <th>Efectivo Rendido</th>
                    <th>Diferencia</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Juan Pérez</strong></td>
                    <td>2</td>
                    <td>$4,500</td>
                    <td class="text-success">$0</td>
                    <td><span class="badge bg-success">Cuadrado</span></td>
                </tr>
                <tr>
                    <td><strong>María Gómez</strong></td>
                    <td>3</td>
                    <td>$5,200</td>
                    <td class="text-danger">-$150</td>
                    <td><span class="badge bg-warning text-dark">Pendiente</span></td>
                </tr>
                <tr>
                    <td><strong>Carlos Ramírez</strong></td>
                    <td>1</td>
                    <td>$4,550</td>
                    <td class="text-success">$0</td>
                    <td><span class="badge bg-success">Cuadrado</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

